---
import Brand from './Brand.astro';
import { site } from '@/data/site';
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand"><Brand /><p>Helping modern brands grow with AI creative, UGC and focused web experiences.</p></div>
    <nav aria-label="Footer quick links"><strong>Quick Links</strong><a href="/work/">Work</a><a href="/services/">Services</a><a href="/about/">About</a><a href="/insights/">Insights</a></nav>
    <nav aria-label="Footer services"><strong>Services</strong><a href="/services/ai-ugc-video-ads/">AI UGC Video Ads</a><a href="/services/ai-video-production/">AI Video Production</a><a href="/services/ai-spokesperson-videos/">AI Spokesperson Videos</a><a href="/services/web-design-development/">Web Design & Development</a></nav>
    <div class="footer__contact"><strong>Connect</strong><a href={site.fiverr} rel="me external">Fiverr</a><a href={`mailto:${site.email}`}>{site.email}</a></div>
  </div>
  <div class="container footer__bottom"><span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><nav aria-label="Legal"><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></nav></div>
</footer>
<style>
.footer{border-top:1px solid var(--color-border);background:#fff}.footer__grid{display:grid;grid-template-columns:1.5fr .7fr 1fr 1fr;gap:2rem;padding-block:1.6rem}.footer__brand p{max-width:18rem;margin-top:.75rem;color:var(--color-text-muted);font-size:.78rem}.footer nav,.footer__contact{display:grid;align-content:start;gap:.35rem}.footer strong{font-size:.75rem}.footer a,.footer__bottom{font-size:.72rem;color:var(--color-text-muted)}.footer a:hover{color:var(--color-brand)}.footer__bottom{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid var(--color-border);padding-block:.85rem}.footer__bottom nav{display:flex;gap:1.25rem}@media(max-width:47.99rem){.footer__grid{grid-template-columns:1fr 1fr;gap:1.25rem}.footer__brand{grid-column:1/-1}.footer__contact{grid-column:1/-1}.footer__bottom{align-items:flex-start;flex-direction:column}.footer__bottom nav{display:flex;flex-wrap:wrap}}
</style>
