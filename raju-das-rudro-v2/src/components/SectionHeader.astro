---
const { eyebrow, title, description, linkHref, linkLabel = 'View all' } = Astro.props;
---
<div class="section-header">
  <div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2>{description && <p>{description}</p>}</div>
  {linkHref && <a href={linkHref}>{linkLabel} <span aria-hidden="true">→</span></a>}
</div>
<style>
.section-header{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.1rem}.section-header>div{display:grid;gap:.2rem}.section-header p:not(.eyebrow){font-size:.82rem;color:var(--color-text-muted)}.section-header>a{font-size:.78rem;color:#2563eb;font-weight:600;white-space:nowrap}@media(max-width:47.99rem){.section-header{align-items:center}.section-header p:not(.eyebrow){font-size:.75rem}.section-header>a{font-size:.7rem}}
</style>
