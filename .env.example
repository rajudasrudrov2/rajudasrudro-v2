# Public environment classification. Only the exact value "production" enables indexing.
PUBLIC_SITE_ENV=development

# Informational deployment origin. Canonical ownership remains https://rajudasrudro.com/.
PUBLIC_SITE_URL=http://localhost:4321

# Optional server-only delivery destination for POST /api/contact.
# Leave empty until a Planning-approved staging/production transport is configured.
# Never expose this value through a PUBLIC_* variable.
CONTACT_FORM_WEBHOOK_URL=
