---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/services';
import { site, verifiedTrust } from '@/data/site';

type ContactProjectIcon = 'video' | 'monitor' | 'users' | 'spark';

const contactIconForService = (slug: string): ContactProjectIcon => {
  if (slug === 'web-design-development') return 'monitor';
  if (slug === 'ai-spokesperson-videos') return 'users';
  return 'video';
};

const contactServiceSlugs = [
  'ai-ugc-video-ads',
  'ai-video-production',
  'ai-spokesperson-videos',
  'web-design-development',
] as const;

const primaryServiceOptions = contactServiceSlugs
  .map((slug) => services.find((service) => service.slug === slug))
  .filter((service): service is NonNullable<typeof service> => Boolean(service))
  .map((service) => ({
    value: service.slug,
    label: service.title,
    icon: contactIconForService(service.slug),
  }));

const serviceOptions: Array<{ value: string; label: string; icon: ContactProjectIcon }> = [
  ...primaryServiceOptions,
  { value: 'other', label: 'Other / Custom Requirement', icon: 'spark' },
];

const budgetOptions = [
  { value: 'under-500', label: 'Under $500' },
  { value: '500-1000', label: '$500 – $1,000' },
  { value: '1000-2500', label: '$1,000 – $2,500' },
  { value: '2500-plus', label: '$2,500+' },
  { value: 'not-sure', label: 'Not sure yet' },
] as const;

const timelineOptions = [
  { value: 'asap', label: 'As soon as possible' },
  { value: '1-2-weeks', label: 'Within 1–2 weeks' },
  { value: 'within-month', label: 'Within a month' },
  { value: 'flexible', label: 'Flexible / Not sure' },
] as const;

const emailHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<BaseLayout
  meta={{
    title: 'Start a Project — Raju Das Rudro',
    description: 'Tell Raju Das Rudro about your AI UGC, AI video, spokesperson or web design project and share the context needed to plan the next step.',
    pathname: '/contact/',
  }}
>
  <section class="section contact-hero">
    <div class="container contact-grid">
      <aside class="contact-intro stack">
        <p class="eyebrow">Start a Project</p>
        <h1>Tell Me About Your Project.</h1>
        <p class="lede">Share your ideas, goals and requirements. I’ll review your inquiry and get back to you with next steps and a clear plan.</p>

        <div class="contact-benefits" aria-label="Project inquiry benefits">
          <div><Icon name="arrow" size={21} /><span><strong>Fast Response</strong><small>{site.responseCommitment}</small></span></div>
          <div><Icon name="spark" size={21} /><span><strong>Tailored Solutions</strong><small>Based on your goals</small></span></div>
          <div><Icon name="check" size={21} /><span><strong>No Obligation</strong><small>A project conversation first</small></span></div>
        </div>

        <div class="contact-portrait surface">
          <img src="/images/raju-das-rudro.webp" width="635" height="640" alt="Raju Das Rudro" loading="eager" fetchpriority="high" decoding="async" />
        </div>

        <div class="contact-note surface">
          <p>A clear brief helps, but you do not need every detail finalized before reaching out. Share the context you already have and we can clarify the rest together.</p>
          <strong>{site.name}</strong>
          <span>AI Creative, UGC & Web Specialist</span>
        </div>
      </aside>

      <div class="form-card surface" id="project-inquiry">
        <div data-form-intro>
          <h2>Project Inquiry Form</h2>
          <p class="muted form-card__intro">Fill in the details below and let’s start the conversation.</p>
        </div>

        <div class="alert alert--validation" hidden data-validation-summary role="alert" tabindex="-1">
          <strong>Please correct the highlighted fields.</strong>
          <span>Each invalid field includes a text explanation.</span>
        </div>

        <div class="alert alert--error" hidden data-submit-error role="alert" tabindex="-1">
          <strong data-submit-error-title>Something went wrong while sending your inquiry.</strong>
          <span data-submit-error-copy>Your details are still here. Please try again or use a direct contact option below.</span>
          <div class="alert__actions">
            <a href={emailHref}>Email me directly</a>
            <a href={site.fiverr} rel="external">View Fiverr Profile</a>
          </div>
        </div>

        <div class="alert alert--error" hidden data-delivery-unavailable role="alert" tabindex="-1">
          <strong>Automated delivery is currently unavailable.</strong>
          <span>Your inquiry was not marked as sent. Please use email or Fiverr instead.</span>
          <div class="alert__actions">
            <a href={emailHref}>Email {site.email}</a>
            <a href={site.fiverr} rel="external">View Fiverr Profile</a>
          </div>
        </div>

        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-form-status></p>

        <div class="no-js-fallback surface">
          <strong>Automated submission needs JavaScript.</strong>
          <p>You can still contact me directly by email or through Fiverr.</p>
          <div class="cluster">
            <Button href={emailHref} variant="secondary">Email Me</Button>
            <Button href={site.fiverr} variant="secondary">View Fiverr Profile ↗</Button>
          </div>
        </div>

        <form novalidate data-contact-form>
          <div class="field-grid">
            <div class="field">
              <label class="field-label" for="contact-name">Name <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
              <input id="contact-name" name="name" autocomplete="name" required minlength="2" maxlength="80" aria-describedby="name-error" placeholder="Your full name" />
              <p class="field-error" id="name-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label class="field-label" for="contact-email">Work Email <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
              <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="254" aria-describedby="email-error" placeholder="you@company.com" />
              <p class="field-error" id="email-error" data-error-for="email"></p>
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="contact-company">Company / Brand <small>(Optional)</small></label>
            <input id="contact-company" name="company" autocomplete="organization" maxlength="120" placeholder="Your company or brand name" />
          </div>

          <div class="field service-field" data-service-field>
            <fieldset class="service-desktop" aria-describedby="service-error">
              <legend>What do you need? <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></legend>
              <div class="option-grid">
                {serviceOptions.map((option) => (
                  <label>
                    <input type="radio" name="serviceChoice" value={option.value} data-service-radio aria-describedby="service-error" />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="service-mobile">
              <label class="field-label" for="contact-service">What do you need? <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
              <select id="contact-service" data-service-select aria-describedby="service-error" required>
                <option value="">Select a service</option>
                {serviceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </div>
            <input type="hidden" name="service" value="" data-service-value />
            <p class="field-error" id="service-error" data-error-for="service"></p>
          </div>

          <div class="field">
            <label class="field-label" for="contact-project-details">Project Details <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
            <textarea
              id="contact-project-details"
              name="projectDetails"
              required
              minlength="20"
              maxlength="1000"
              rows="6"
              aria-describedby="project-details-help project-details-error"
              placeholder="Tell me about your project, goals, target audience, style preferences, references (if any) and any other important details."
            ></textarea>
            <div class="field__meta">
              <div>
                <small id="project-details-help">Please provide at least 20 characters.</small>
                <p class="field-error" id="project-details-error" data-error-for="projectDetails"></p>
              </div>
              <small aria-live="off"><span data-char-count>0</span>/1000</small>
            </div>
          </div>

          <div class="optional-group">
            <fieldset class="choice-field">
              <legend class="field-label" id="budget-label">Budget Range <small>(Optional)</small></legend>
              <div class="choice-desktop">
                {budgetOptions.map((option) => (
                  <label>
                    <input type="radio" name="budgetChoice" value={option.value} data-budget-radio />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
              <select class="choice-mobile" data-budget-select aria-labelledby="budget-label">
                <option value="">Select a budget range</option>
                {budgetOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
              <input type="hidden" name="budget" value="" data-budget-value />
            </fieldset>

            <fieldset class="choice-field">
              <legend class="field-label" id="timeline-label">Timeline <small>(Optional)</small></legend>
              <div class="choice-desktop">
                {timelineOptions.map((option) => (
                  <label>
                    <input type="radio" name="timelineChoice" value={option.value} data-timeline-radio />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
              <select class="choice-mobile" data-timeline-select aria-labelledby="timeline-label">
                <option value="">Select a timeline</option>
                {timelineOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
              <input type="hidden" name="timeline" value="" data-timeline-value />
            </fieldset>
          </div>
          <p class="qualifier-note">Budget and timeline are optional planning context only. Final scope, pricing and delivery timing are confirmed separately.</p>

          <div class="honeypot" aria-hidden="true">
            <label for="contact-website">Leave this field empty</label>
            <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button class="submit" type="submit" data-submit>Send Project Inquiry <span aria-hidden="true">→</span></button>
          <p class="privacy-note">Your information is used only to discuss your project. Read the <a href="/privacy-policy/">Privacy Policy</a>.</p>
          <p class="direct-email">Prefer email? <a href={emailHref}>{site.email}</a></p>
        </form>

        <section class="submission-success" hidden data-success-state role="status" tabindex="-1" aria-labelledby="contact-success-title">
          <div class="success-mark" aria-hidden="true"><Icon name="check" size={42} /></div>
          <h2 id="contact-success-title">Project received.</h2>
          <p>Thank you for reaching out. Your project inquiry was sent successfully. I’ll review the details and respond {site.responseCommitment.toLowerCase()}.</p>
          <div class="cluster success-actions">
            <Button href="/work/">View My Work</Button>
            <Button href="/" variant="secondary">Return Home</Button>
          </div>
          <div class="success-note">
            <strong>Need to add something?</strong>
            <span>Email <a href={emailHref}>{site.email}</a> and include any extra context.</span>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="section section--soft next-section">
    <div class="container next-grid">
      <div>
        <p class="eyebrow">Simple and transparent</p>
        <h2>What Happens Next?</h2>
        <div class="steps">
          <article><strong>01</strong><h3>Submit</h3><p>Send your project details and useful context.</p></article>
          <article><strong>02</strong><h3>Review</h3><p>I’ll review the request and clarify anything important. {site.responseCommitment}.</p></article>
          <article><strong>03</strong><h3>Next Step</h3><p>We’ll discuss scope, direction and the most suitable next step.</p></article>
        </div>
      </div>
      <div class="surface fiverr">
        <h2>Prefer Fiverr?</h2>
        <p>If you’d prefer to work with me on Fiverr, you can use my existing profile there.</p>
        <Button href={site.fiverr} variant="secondary">View Fiverr Profile ↗</Button>
        <p class="fiverr-email">Or email <a href={emailHref}>{site.email}</a></p>
      </div>
    </div>
  </section>

  <section class="section contact-context">
    <div class="container context-grid">
      <div>
        <p class="eyebrow">Common Project Types</p>
        <h2>Choose the closest fit.</h2>
        <div class="project-types">
          {serviceOptions.map((option) => (
            <article class="surface project-type">
              <span class="project-type__icon"><Icon name={option.icon} size={20} /></span>
              <strong>{option.label}</strong>
              <small>{option.value === 'other' ? 'Custom or mixed requirements' : services.find((service) => service.slug === option.value)?.chooser}</small>
            </article>
          ))}
        </div>
      </div>

      <aside class="trust-panel surface">
        <p class="eyebrow">Client Feedback</p>
        <h2>Existing verified trust signals.</h2>
        <div class="trust-items">
          {verifiedTrust.map((item) => (
            <div>
              <Icon name={item.label.includes('Rating') ? 'star' : 'users'} size={24} />
              <span><strong>{item.value}</strong><small>{item.label}</small></span>
            </div>
          ))}
        </div>
        <p>These aggregate Fiverr trust signals are separate from any specific project or service claim.</p>
      </aside>
    </div>
  </section>

  <section class="contact-final">
    <div class="container contact-final__inner">
      <div><h2>Ready to share your project?</h2><p>Send the context you have and we can clarify the next step from there.</p></div>
      <div class="cluster"><Button href="/contact/#project-inquiry">Start a Project</Button><Button href="/work/" variant="dark">View My Work</Button></div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(() => {
  const form = document.querySelector('[data-contact-form]');
  if (!(form instanceof HTMLFormElement)) return;

  const endpoint = '/api/contact';
  const submit = form.querySelector('[data-submit]');
  const formIntro = document.querySelector('[data-form-intro]');
  const successState = document.querySelector('[data-success-state]');
  const submitError = document.querySelector('[data-submit-error]');
  const submitErrorTitle = document.querySelector('[data-submit-error-title]');
  const submitErrorCopy = document.querySelector('[data-submit-error-copy]');
  const deliveryUnavailable = document.querySelector('[data-delivery-unavailable]');
  const validationSummary = document.querySelector('[data-validation-summary]');
  const status = document.querySelector('[data-form-status]');
  const details = form.elements.namedItem('projectDetails');
  const charCount = form.querySelector('[data-char-count]');
  const serviceValue = form.querySelector('[data-service-value]');
  const serviceSelect = form.querySelector('[data-service-select]');
  const budgetValue = form.querySelector('[data-budget-value]');
  const budgetSelect = form.querySelector('[data-budget-select]');
  const timelineValue = form.querySelector('[data-timeline-value]');
  const timelineSelect = form.querySelector('[data-timeline-select]');

  const statusMessages = {
    idle: '',
    'validation-error': 'Please correct the highlighted fields.',
    submitting: 'Sending your project inquiry.',
    success: 'Project inquiry sent successfully.',
    'server-error': 'Your inquiry could not be sent.',
    'delivery-unavailable': 'Automated delivery is currently unavailable.',
    'network-error': 'A network error prevented submission. Your form values have been preserved.',
  };

  let isSubmitting = false;
  let currentState = 'idle';

  const trackSuccessfulLead = () => {
    const analytics = window.rdrAnalyticsConsent;
    const analyticsState = typeof analytics?.debug === 'function' ? analytics.debug() : null;

    if (
      analyticsState?.productionHost !== true
      || analyticsState?.choice !== 'granted'
      || analyticsState?.tagLoaded !== true
      || typeof window.gtag !== 'function'
    ) {
      return;
    }

    window.gtag('event', 'generate_lead', {
      form_name: 'project_inquiry',
    });
  };

  const setStatus = (message = '') => {
    if (status) status.textContent = message;
  };

  const setHiddenChoice = (type, value) => {
    const hidden = type === 'service' ? serviceValue : type === 'budget' ? budgetValue : timelineValue;
    const select = type === 'service' ? serviceSelect : type === 'budget' ? budgetSelect : timelineSelect;
    const radios = form.querySelectorAll(`[data-${type}-radio]`);

    if (hidden instanceof HTMLInputElement) hidden.value = value;
    if (select instanceof HTMLSelectElement) select.value = value;
    radios.forEach((radio) => {
      if (radio instanceof HTMLInputElement) radio.checked = radio.value === value;
    });
  };

  const setFormState = (nextState, { focus = false } = {}) => {
    currentState = nextState;

    const showValidation = nextState === 'validation-error';
    const showSuccess = nextState === 'success';
    const showSubmitError = nextState === 'server-error' || nextState === 'network-error';
    const showDeliveryUnavailable = nextState === 'delivery-unavailable';
    const submitting = nextState === 'submitting';

    if (validationSummary instanceof HTMLElement) validationSummary.hidden = !showValidation;
    if (successState instanceof HTMLElement) successState.hidden = !showSuccess;
    if (submitError instanceof HTMLElement) submitError.hidden = !showSubmitError;
    if (deliveryUnavailable instanceof HTMLElement) deliveryUnavailable.hidden = !showDeliveryUnavailable;

    if (submitErrorTitle && submitErrorCopy && showSubmitError) {
      if (nextState === 'network-error') {
        submitErrorTitle.textContent = 'A network error prevented submission.';
        submitErrorCopy.textContent = 'Your details are still here. Check your connection and try again, or use a direct contact option below.';
      } else {
        submitErrorTitle.textContent = 'Something went wrong while sending your inquiry.';
        submitErrorCopy.textContent = 'Your details are still here. Please try again or use a direct contact option below.';
      }
    }

    form.hidden = showSuccess;
    if (formIntro instanceof HTMLElement) formIntro.hidden = showSuccess;

    if (submitting) form.setAttribute('aria-busy', 'true');
    else form.removeAttribute('aria-busy');

    if (submit instanceof HTMLButtonElement) {
      submit.disabled = submitting;
      submit.toggleAttribute('aria-disabled', submitting);
      submit.innerHTML = submitting
        ? 'Sending…'
        : 'Send Project Inquiry <span aria-hidden="true">→</span>';
    }

    setStatus(statusMessages[nextState] || '');

    if (!focus) return;

    const target =
      showValidation ? validationSummary
      : showSuccess ? successState
      : showDeliveryUnavailable ? deliveryUnavailable
      : showSubmitError ? submitError
      : null;

    if (target instanceof HTMLElement) {
      target.focus({ preventScroll: true });
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  ['service', 'budget', 'timeline'].forEach((type) => {
    form.querySelectorAll(`[data-${type}-radio]`).forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio instanceof HTMLInputElement && radio.checked) {
          setHiddenChoice(type, radio.value);
        }
      });
    });

    const select = form.querySelector(`[data-${type}-select]`);
    if (select instanceof HTMLSelectElement) {
      select.addEventListener('change', () => setHiddenChoice(type, select.value));
    }
  });

  const setFieldError = (name, message = '') => {
    const error = form.querySelector(`[data-error-for="${name}"]`);
    if (error) error.textContent = message;

    const controls = name === 'service'
      ? form.querySelectorAll('[data-service-radio], [data-service-select]')
      : form.querySelectorAll(`[name="${name}"]`);

    controls.forEach((control) => {
      if (!(control instanceof HTMLElement)) return;
      if (message) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    });
  };

  const getValues = () => {
    const name = form.elements.namedItem('name');
    const email = form.elements.namedItem('email');
    const company = form.elements.namedItem('company');
    const projectDetails = form.elements.namedItem('projectDetails');
    const service = form.elements.namedItem('service');
    const budget = form.elements.namedItem('budget');
    const timeline = form.elements.namedItem('timeline');
    const website = form.elements.namedItem('website');

    return {
      name: name instanceof HTMLInputElement ? name.value.trim() : '',
      email: email instanceof HTMLInputElement ? email.value.trim() : '',
      company: company instanceof HTMLInputElement ? company.value.trim() : '',
      service: service instanceof HTMLInputElement ? service.value : '',
      projectDetails: projectDetails instanceof HTMLTextAreaElement ? projectDetails.value.trim() : '',
      budget: budget instanceof HTMLInputElement ? budget.value : '',
      timeline: timeline instanceof HTMLInputElement ? timeline.value : '',
      website: website instanceof HTMLInputElement ? website.value : '',
    };
  };

  const validate = () => {
    const values = getValues();
    const errors = [];
    ['name', 'email', 'service', 'projectDetails'].forEach((name) => setFieldError(name));

    const nameControl = form.elements.namedItem('name');
    const emailControl = form.elements.namedItem('email');
    const detailsControl = form.elements.namedItem('projectDetails');
    const firstServiceControl = form.querySelector('[data-service-select]') || form.querySelector('[data-service-radio]');

    if (values.name.length < 2 || values.name.length > 80) {
      setFieldError('name', 'Please enter a name between 2 and 80 characters.');
      if (nameControl instanceof HTMLElement) errors.push(nameControl);
    }

    if (!(emailControl instanceof HTMLInputElement) || !emailControl.validity.valid || values.email.length > 254) {
      setFieldError('email', 'Please enter a valid email address.');
      if (emailControl instanceof HTMLElement) errors.push(emailControl);
    }

    if (!values.service) {
      setFieldError('service', 'Please select a service or custom requirement.');
      if (firstServiceControl instanceof HTMLElement) errors.push(firstServiceControl);
    }

    if (values.projectDetails.length < 20 || values.projectDetails.length > 1000) {
      setFieldError('projectDetails', 'Please add between 20 and 1000 characters of project detail.');
      if (detailsControl instanceof HTMLElement) errors.push(detailsControl);
    }

    return errors.length === 0 ? values : null;
  };

  if (details instanceof HTMLTextAreaElement) {
    details.addEventListener('input', () => {
      if (charCount) charCount.textContent = String(details.value.length);
      if (
        details.getAttribute('aria-invalid') === 'true'
        && details.value.trim().length >= 20
        && details.value.trim().length <= 1000
      ) {
        setFieldError('projectDetails');
      }
    });
  }

  form.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (target.name === 'name' && target.value.trim().length >= 2 && target.value.trim().length <= 80) {
      setFieldError('name');
    }
    if (target.name === 'email' && target.validity.valid) setFieldError('email');
  });

  form.addEventListener('change', (event) => {
    const target = event.target;
    if (
      (target instanceof HTMLInputElement || target instanceof HTMLSelectElement)
      && (target.matches('[data-service-radio]') || target.matches('[data-service-select]'))
      && getValues().service
    ) {
      setFieldError('service');
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isSubmitting) return;

    setFormState('idle');

    const values = validate();
    if (!values) {
      setFormState('validation-error', { focus: true });
      return;
    }

    isSubmitting = true;
    setFormState('submitting');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(values),
      });

      let result = null;
      try {
        result = await response.json();
      } catch {
        result = null;
      }

      if (response.status === 422 && result?.fieldErrors && typeof result.fieldErrors === 'object') {
        Object.entries(result.fieldErrors).forEach(([field, message]) => {
          if (typeof message === 'string') setFieldError(field, message);
        });
        setFormState('validation-error', { focus: true });
        return;
      }

      if (!response.ok || !result?.ok) {
        const unavailable = response.status === 503 || result?.code === 'DELIVERY_UNAVAILABLE';
        setFormState(unavailable ? 'delivery-unavailable' : 'server-error', { focus: true });
        return;
      }

      form.reset();
      setHiddenChoice('service', '');
      setHiddenChoice('budget', '');
      setHiddenChoice('timeline', '');
      if (charCount) charCount.textContent = '0';
      ['name', 'email', 'service', 'projectDetails'].forEach((name) => setFieldError(name));
      setFormState('success', { focus: true });
      trackSuccessfulLead();
    } catch {
      setFormState('network-error', { focus: true });
    } finally {
      isSubmitting = false;
      if (currentState === 'submitting') setFormState('idle');
    }
  });

  setFormState('idle');
})();
</script>

<style>
.form-card [hidden]{display:none!important}
.contact-hero{padding-top:var(--space-8)}
.contact-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(34rem,1.18fr);gap:2rem;align-items:start}
.contact-intro{padding-top:.9rem}
