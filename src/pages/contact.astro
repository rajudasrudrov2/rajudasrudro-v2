---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { site } from '@/data/site';

const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---
<BaseLayout meta={{ title: 'Start a Project — Raju Das Rudro', description: 'Tell Raju Das Rudro about your AI UGC, AI video, spokesperson or web project.', pathname: '/contact/' }}>
  <section class="section contact-page">
    <div class="container contact-grid">
      <aside class="contact-intro stack">
        <p class="eyebrow">Start a Project</p>
        <h1>Tell Me About Your Project.</h1>
        <p class="lede">Share your ideas, goals and requirements. I’ll review your inquiry and get back to you with next steps and a clear plan.</p>
        <div class="contact-benefits">
          <span>⚡ <strong>Fast Response</strong><small>{site.responseCommitment}</small></span>
          <span>◎ <strong>Tailored Solutions</strong><small>Based on your goals</small></span>
          <span>♡ <strong>No Obligation</strong><small>Just a friendly conversation</small></span>
        </div>
        <div class="contact-portrait surface">
          <img src="/images/raju-das-rudro.webp" width="635" height="640" alt="Raju Das Rudro" loading="lazy" />
        </div>
      </aside>

      <div class="form-card surface">
        <h2>Project Inquiry Form</h2>
        <p class="muted form-card__intro">Fill in the details below and let’s start the conversation.</p>

        <div class="alert alert--validation" hidden data-validation-summary role="alert">
          <strong>Please correct the highlighted fields.</strong>
          <span>Each invalid field includes a text explanation.</span>
        </div>
        <div class="alert alert--success" hidden data-success role="status" tabindex="-1">
          <strong>Project received.</strong>
          <span>Thank you. Your inquiry has been submitted successfully.</span>
        </div>
        <div class="alert alert--error" hidden data-submit-error role="alert" tabindex="-1">
          <strong>Something went wrong while sending your inquiry.</strong>
          <span>Please try again. Your information has not been confirmed as sent.</span>
        </div>
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-form-status></p>

        <form novalidate data-contact-form data-endpoint={endpoint}>
          <div class="field-grid">
            <div class="field">
              <label class="field-label" for="contact-name">Name <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
              <input id="contact-name" name="name" autocomplete="name" required minlength="2" aria-describedby="name-error" placeholder="Your full name" />
              <p class="field-error" id="name-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label class="field-label" for="contact-email">Work Email <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
              <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" required aria-describedby="email-error" placeholder="you@company.com" />
              <p class="field-error" id="email-error" data-error-for="email"></p>
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="contact-company">Company / Brand <small>(Optional)</small></label>
            <input id="contact-company" name="company" autocomplete="organization" placeholder="Your company or brand name" />
          </div>

          <fieldset class="field service-options" aria-describedby="service-error">
            <legend>What do you need? <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></legend>
            <div class="option-grid">
              <label><input type="radio" name="service" value="AI UGC Video Ads" required aria-describedby="service-error" /><span>AI UGC Video Ads</span></label>
              <label><input type="radio" name="service" value="AI Video Production" aria-describedby="service-error" /><span>AI Video Production</span></label>
              <label><input type="radio" name="service" value="AI Spokesperson Videos" aria-describedby="service-error" /><span>AI Spokesperson Videos</span></label>
              <label><input type="radio" name="service" value="Web Design & Development" aria-describedby="service-error" /><span>Web Design & Development</span></label>
              <label><input type="radio" name="service" value="Custom AI Project" aria-describedby="service-error" /><span>Custom AI Project</span></label>
              <label><input type="radio" name="service" value="Something Else" aria-describedby="service-error" /><span>Something Else</span></label>
            </div>
            <p class="field-error" id="service-error" data-error-for="service"></p>
          </fieldset>

          <div class="field">
            <label class="field-label" for="contact-details">Project Details <span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
            <textarea id="contact-details" name="details" required minlength="20" maxlength="1000" rows="6" aria-describedby="details-help details-error" placeholder="Tell me about your project, goals, target audience, style preferences, references and timeline."></textarea>
            <div class="field__meta">
              <div>
                <small id="details-help">Please provide at least 20 characters.</small>
                <p class="field-error" id="details-error" data-error-for="details"></p>
              </div>
              <small aria-live="off"><span data-char-count>0</span>/1000</small>
            </div>
          </div>

          <div class="field-grid">
            <div class="field">
              <label class="field-label" for="contact-budget">Budget Range <small>(Optional)</small></label>
              <select id="contact-budget" name="budget">
                <option value="">Select a budget range</option>
                <option>Under $500</option>
                <option>$500 – $1,000</option>
                <option>$1,000 – $2,500</option>
                <option>$2,500+</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="contact-timeline">Timeline <small>(Optional)</small></label>
              <select id="contact-timeline" name="timeline">
                <option value="">Select a timeline</option>
                <option>As soon as possible</option>
                <option>Within 1–2 weeks</option>
                <option>Within a month</option>
                <option>Flexible / Not sure</option>
              </select>
            </div>
          </div>

          <div class="honeypot" aria-hidden="true">
            <label for="contact-website">Leave this field empty</label>
            <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button class="submit" type="submit" data-submit>Send Project Inquiry <span aria-hidden="true">→</span></button>
          <p class="privacy-note">Your information is used only to discuss your project. Read the <a href="/privacy-policy/">Privacy Policy</a>.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container next-grid">
      <div>
        <h2>What Happens Next?</h2>
        <div class="steps">
          <article><strong>01</strong><h3>Submit</h3><p>You’ve sent your inquiry.</p></article>
          <article><strong>02</strong><h3>Review</h3><p>I’ll review your details. {site.responseCommitment}.</p></article>
          <article><strong>03</strong><h3>Next Step</h3><p>We’ll discuss the best approach and next steps.</p></article>
        </div>
      </div>
      <div class="surface fiverr">
        <h2>Prefer Fiverr?</h2>
        <p>If you’d prefer to work with me on Fiverr, you can check out my profile there.</p>
        <Button href={site.fiverr} variant="secondary">View Fiverr Profile ↗</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(() => {
  const form = document.querySelector('[data-contact-form]');
  if (!(form instanceof HTMLFormElement)) return;

  const submit = form.querySelector('[data-submit]');
  const success = document.querySelector('[data-success]');
  const submitError = document.querySelector('[data-submit-error]');
  const validationSummary = document.querySelector('[data-validation-summary]');
  const status = document.querySelector('[data-form-status]');
  const details = form.elements.namedItem('details');
  const charCount = form.querySelector('[data-char-count]');
  const endpoint = form.dataset.endpoint || '';

  const setStatus = (message = '') => {
    if (status) status.textContent = message;
  };

  const setFieldError = (name, message = '') => {
    const error = form.querySelector(`[data-error-for="${name}"]`);
    if (error) error.textContent = message;
    form.querySelectorAll(`[name="${name}"]`).forEach((control) => {
      if (control instanceof HTMLElement) {
        if (message) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      }
    });
  };

  const validate = () => {
    const errors = [];
    ['name', 'email', 'details', 'service'].forEach((name) => setFieldError(name));

    const name = form.elements.namedItem('name');
    const email = form.elements.namedItem('email');
    const projectDetails = form.elements.namedItem('details');

    if (name instanceof HTMLInputElement && name.value.trim().length < 2) {
      setFieldError('name', 'Please enter your name.');
      errors.push(name);
    }
    if (email instanceof HTMLInputElement && !email.validity.valid) {
      setFieldError('email', 'Please enter a valid email address.');
      errors.push(email);
    }
    if (!form.querySelector('input[name="service"]:checked')) {
      setFieldError('service', 'Please select a service.');
      const firstService = form.querySelector('input[name="service"]');
      if (firstService instanceof HTMLInputElement) errors.push(firstService);
    }
    if (projectDetails instanceof HTMLTextAreaElement && projectDetails.value.trim().length < 20) {
      setFieldError('details', 'Please add at least 20 characters of project detail.');
      errors.push(projectDetails);
    }

    if (validationSummary instanceof HTMLElement) validationSummary.hidden = errors.length === 0;
    if (errors.length > 0) {
      errors[0].focus();
      return false;
    }
    return true;
  };

  if (details instanceof HTMLTextAreaElement) {
    details.addEventListener('input', () => {
      if (charCount) charCount.textContent = String(details.value.length);
      if (details.getAttribute('aria-invalid') === 'true' && details.value.trim().length >= 20) setFieldError('details');
    });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (success instanceof HTMLElement) success.hidden = true;
    if (submitError instanceof HTMLElement) submitError.hidden = true;
    setStatus('');

    if (!validate()) return;
    if (validationSummary instanceof HTMLElement) validationSummary.hidden = true;

    if (submit instanceof HTMLButtonElement) {
      submit.disabled = true;
      submit.setAttribute('aria-disabled', 'true');
      submit.textContent = 'Sending…';
    }
    form.setAttribute('aria-busy', 'true');
    setStatus('Submitting your project inquiry.');

    try {
      if (!endpoint) throw new Error('Contact endpoint is not configured');
      const body = Object.fromEntries(new FormData(form).entries());
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) throw new Error('Submission failed');

      form.reset();
      if (charCount) charCount.textContent = '0';
      ['name', 'email', 'details', 'service'].forEach((name) => setFieldError(name));
      setStatus('');
      if (success instanceof HTMLElement) {
        success.hidden = false;
        success.focus({ preventScroll: true });
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch {
      setStatus('');
      if (submitError instanceof HTMLElement) {
        submitError.hidden = false;
        submitError.focus({ preventScroll: true });
        submitError.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } finally {
      form.removeAttribute('aria-busy');
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = false;
        submit.removeAttribute('aria-disabled');
        submit.innerHTML = 'Send Project Inquiry <span aria-hidden="true">→</span>';
      }
    }
  });
})();
</script>

<style>
.contact-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:2.5rem;align-items:start}.contact-intro h1{font-size:var(--fs-hero);max-width:10ch}.contact-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.contact-benefits span{display:grid;gap:.15rem;font-size:.75rem}.contact-benefits small{font-size:.63rem;color:var(--color-text-muted)}.contact-portrait{overflow:hidden;margin-top:.5rem}.contact-portrait img{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:center 28%}.form-card{padding:1.4rem}.form-card__intro{font-size:.82rem;margin:.3rem 0 1rem}.form-card form{display:grid;gap:1rem}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.field{display:grid;gap:.4rem;border:0;padding:0;margin:0;min-width:0}.field-label,.field legend{font-size:.75rem;font-weight:600}.required-marker{color:var(--color-brand)}.field small{font-weight:400;color:var(--color-text-muted)}.field input,.field textarea,.field select{width:100%;min-height:2.75rem;border:1px solid #cbd5e1;border-radius:var(--radius-md);background:#fff;padding:.72rem .75rem;color:var(--color-text);font-size:.82rem}.field textarea{resize:vertical;min-height:8rem}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--color-focus);box-shadow:var(--focus);outline:0}.field [aria-invalid="true"]{border-color:var(--color-error)}.field-error{min-height:.85rem;color:var(--color-error);font-size:.65rem;font-style:normal}.field__meta{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}.field__meta>div{display:grid;gap:.15rem}.field__meta small{font-size:.65rem}.option-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem}.option-grid label{position:relative}.option-grid input{position:absolute;opacity:0;width:1px;height:1px}.option-grid span{display:flex;align-items:center;justify-content:center;min-height:2.75rem;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:.5rem;text-align:center;font-size:.7rem;cursor:pointer}.option-grid input:checked+span{border-color:var(--color-brand);background:#fff7f7;color:var(--color-brand)}.option-grid input:focus-visible+span{box-shadow:var(--focus)}.option-grid input[aria-invalid="true"]+span{border-color:var(--color-error)}.submit{display:flex;align-items:center;justify-content:center;min-height:2.9rem;border:1px solid var(--color-brand);border-radius:var(--radius-md);background:var(--color-brand);color:#fff;font-weight:700;cursor:pointer}.submit:disabled{background:#cbd5e1;border-color:#cbd5e1;cursor:wait}.privacy-note{text-align:center;color:var(--color-text-muted);font-size:.65rem}.privacy-note a{text-decoration:underline}.honeypot{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.alert{display:grid;gap:.15rem;padding:.85rem 1rem;border-radius:var(--radius-md);font-size:.75rem}.alert--success{background:#ecfdf5;color:#047857}.alert--error,.alert--validation{background:#fff1f2;color:#b91c1c}.next-grid{display:grid;grid-template-columns:1.6fr .8fr;gap:1rem}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin-top:.8rem}.steps article{border:1px solid var(--color-border);border-radius:var(--radius-md);padding:1rem}.steps strong{color:var(--color-brand);font-family:var(--font-display);font-size:1.25rem}.steps h3{font-size:.95rem;margin:.25rem 0}.steps p,.fiverr p{font-size:.72rem;color:var(--color-text-muted)}.fiverr{padding:1rem;display:grid;align-content:start;gap:.7rem}.fiverr .button{justify-self:start}@media(max-width:47.99rem){.contact-grid,.next-grid{grid-template-columns:1fr}.contact-intro h1{font-size:2.3rem;max-width:none}.contact-portrait{display:none}.contact-benefits{grid-template-columns:repeat(3,1fr)}.field-grid{grid-template-columns:1fr}.option-grid{grid-template-columns:1fr}.steps{grid-template-columns:1fr}.form-card{padding:1rem}}
</style>
