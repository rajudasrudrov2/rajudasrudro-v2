---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/CTA.astro';
---
<BaseLayout meta={{ title: 'About — Raju Das Rudro', description: 'About Raju Das Rudro, an AI creative, UGC and web specialist working with modern brands.', pathname: '/about/' }}>
  <section class="section"><div class="container about-hero"><div class="stack"><p class="eyebrow">About</p><h1>Raju Das Rudro</h1><p class="lede">AI Creative, UGC &amp; Web Specialist</p><p>I help businesses create professional video assets and modern web experiences with a focus on clarity, execution and measurable commercial use.</p><div class="cluster"><Button href="/contact/">Start a Project</Button><Button href="/work/" variant="secondary">View My Work</Button></div></div><div class="portrait surface"><img src="/images/raju-das-rudro.webp" width="635" height="640" alt="Raju Das Rudro" /></div></div></section>
  <section class="section section--soft"><div class="container story"><div><p class="eyebrow">My Story</p><h2>From Digital Marketing to AI-Driven Creative Work</h2><p>My background spans content marketing, YouTube growth, video production and AI-assisted creative workflows. V2 focuses that experience into clear commercial services rather than a generic “anything AI” offer.</p></div><div><h2>What I Do Today</h2><div class="grid-2"><article class="surface"><h3>AI UGC</h3><p>UGC-style ad creative and hook-driven brand videos.</p></article><article class="surface"><h3>AI Video</h3><p>Product, commercial and branded video production.</p></article><article class="surface"><h3>AI Spokesperson</h3><p>Presenter-led content without traditional filming.</p></article><article class="surface"><h3>Web Design &amp; Development</h3><p>Modern, responsive websites with a performance-first foundation.</p></article></div></div></div></section>
  <div class="container cta-wrap"><CTA /></div>
</BaseLayout>
<style>.about-hero{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}.about-hero h1{font-size:var(--fs-hero)}.about-hero p:not(.eyebrow):not(.lede){color:var(--color-text-muted);max-width:42rem}.portrait{overflow:hidden;max-height:30rem}.portrait img{width:100%;height:100%;object-fit:cover}.story{display:grid;grid-template-columns:.9fr 1.1fr;gap:3rem}.story>div{display:grid;align-content:start;gap:.8rem}.story p{color:var(--color-text-muted)}.story article{padding:1rem}.story article p{font-size:var(--fs-body-sm);margin-top:.35rem}.cta-wrap{padding-block:1rem 2rem}@media(max-width:47.99rem){.about-hero,.story{grid-template-columns:1fr}.about-hero h1{font-size:2.4rem}.portrait{max-height:20rem}}
</style>
