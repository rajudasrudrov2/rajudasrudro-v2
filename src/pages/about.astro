---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import TrustMetric from '@/components/TrustMetric.astro';
import { aboutClientExpectations, aboutContent, aboutPillars, aboutPrinciples, aboutSelectedWorkIds } from '@/data/about';
import { publicReviewSummaries } from '@/data/reviews';
import { services } from '@/data/services';
import { workTrustMetrics } from '@/data/work';
import { featuredWorkProject, workProjects } from '@/data/work';

const serviceBySlug = new Map(services.map((service) => [service.slug, service] as const));
const workById = new Map([featuredWorkProject, ...workProjects].map((project) => [project.id, project] as const));

const pillars = aboutPillars.map((pillar) => ({
  ...pillar,
  services: pillar.serviceSlugs.map((slug) => serviceBySlug.get(slug)).filter(Boolean),
  media: serviceBySlug.get(pillar.serviceSlugs[0])?.media,
}));

const selectedWork = aboutSelectedWorkIds.map((id) => workById.get(id)).filter(Boolean);
const reviews = publicReviewSummaries.slice(0, 2);
---
<BaseLayout
  meta={{
    title: aboutContent.seo.title,
    description: aboutContent.seo.description,
    pathname: '/about/',
    image: '/images/raju-das-rudro.webp',
  }}
>
  <section class="about-hero" aria-labelledby="about-title">
    <div class="container about-hero__grid">
      <div class="about-hero__copy">
        <p class="eyebrow">{aboutContent.eyebrow}</p>
        <h1 id="about-title">{aboutContent.title}</h1>
        <p class="about-hero__role">{aboutContent.role}</p>
        <p class="about-hero__intro">{aboutContent.intro}</p>
        <div class="about-hero__actions">
          <Button href="/work/">View My Work <Icon name="arrow" size={15} /></Button>
          <Button href="/contact/" variant="secondary">Start a Project</Button>
        </div>
      </div>

      <div class="about-hero__media">
        <img
          src="/images/raju-das-rudro.webp"
          width="635"
          height="640"
          alt="Portrait of Raju Das Rudro"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <aside class="about-hero__focus surface" aria-label="Current professional focus">
          <strong>Turning ideas into useful creative and web work</strong>
          <span><Icon name="spark" size={16} /> AI Creative</span>
          <span><Icon name="video" size={16} /> UGC & Video</span>
          <span><Icon name="monitor" size={16} /> Web Development</span>
        </aside>
      </div>
    </div>

    <div class="about-trust">
      <div class="container about-trust__grid">
        {workTrustMetrics.map((item) => <TrustMetric {...item} />)}
      </div>
    </div>
  </section>

  <section class="about-section" aria-labelledby="story-title">
    <div class="container about-split about-split--story">
      <div class="about-story">
        <p class="eyebrow">My Story</p>
        <h2 id="story-title">{aboutContent.storyTitle}</h2>
        <div class="about-story__copy">
          {aboutContent.story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="about-specialization" aria-labelledby="today-title">
        <div class="about-heading-row">
          <div>
            <h2 id="today-title">What I Do Today</h2>
            <p>Three connected areas I focus on for modern brands and teams.</p>
          </div>
          <a href="/services/" class="about-inline-link">View All Services <Icon name="arrow" size={14} /></a>
        </div>

        <div class="about-pillars">
          {pillars.map((pillar) => (
            <article class="about-pillar surface">
              <div class="about-pillar__top">
                <span class="about-pillar__number">{pillar.number}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.description}</p>
              </div>
              {pillar.media && (
                <img
                  src={pillar.media.src}
                  alt={pillar.media.alt}
                  width={pillar.media.width}
                  height={pillar.media.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="about-pillar__links" aria-label={`${pillar.title} service links`}>
                {pillar.services.map((service) => service && (
                  <a href={service.href}>{service.title} <Icon name="arrow" size={13} /></a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="about-section about-section--soft" aria-labelledby="principles-title">
    <div class="container about-split about-split--principles">
      <div>
        <div class="about-section-heading">
          <h2 id="principles-title">How I Think About Client Work</h2>
          <p>A simple, practical approach designed to keep the work clear and useful.</p>
        </div>
        <div class="about-principles">
          {aboutPrinciples.map((item) => (
            <article class="about-principle surface">
              <span class="about-icon" aria-hidden="true"><Icon name={item.icon} size={19} /></span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <div class="about-section-heading">
          <h2>Experience & Credibility</h2>
          <p>Accepted public proof and the current service focus—without inflated claims.</p>
        </div>
        <div class="about-credibility surface">
          {workTrustMetrics.map((item) => (
            <div class="about-credibility__item">
              <Icon name={item.icon} size={23} />
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
          <div class="about-credibility__item">
            <Icon name="briefcase" size={23} />
            <strong>AI, Video & Web</strong>
            <span>Current Service Focus</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section" aria-labelledby="reviews-title">
    <div class="container about-split about-split--proof">
      <div class="about-reviews">
        <div class="about-heading-row">
          <div>
            <h2 id="reviews-title">What Clients Say</h2>
            <p>Verified public Fiverr review summaries from the accepted source data.</p>
          </div>
          <a href="/reviews/" class="about-inline-link">Read More Reviews <Icon name="arrow" size={14} /></a>
        </div>
        <div class="about-review-grid">
          {reviews.map((review) => <ReviewCard review={review} />)}
        </div>
      </div>

      <div class="about-work" aria-labelledby="selected-work-title">
        <div class="about-heading-row">
          <div>
            <h2 id="selected-work-title">Selected Work</h2>
            <p>Current development-preview records reused from the shared Work registry.</p>
          </div>
          <a href="/work/" class="about-inline-link">View All Work <Icon name="arrow" size={14} /></a>
        </div>
        <div class="about-work__grid">
          {selectedWork.map((project) => project && <ProjectCard project={project} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="about-section about-section--soft" aria-labelledby="personal-note-title">
    <div class="container about-bottom-grid">
      <article class="about-personal surface">
        <img
          src="/images/raju-das-rudro.webp"
          width="635"
          height="640"
          alt="Raju Das Rudro"
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2 id="personal-note-title">A Personal Note</h2>
          <p>{aboutContent.personalNote}</p>
          <span class="about-signoff">— Raju Das Rudro</span>
        </div>
      </article>

      <div class="about-expectations" aria-labelledby="expectations-title">
        <div class="about-section-heading">
          <h2 id="expectations-title">What Clients Can Expect</h2>
          <p>A reliable, collaborative working experience within a clearly defined project scope.</p>
        </div>
        <div class="about-expectations__grid">
          {aboutClientExpectations.map((item) => (
            <article class="about-expectation surface">
              <span class="about-icon" aria-hidden="true"><Icon name={item.icon} size={18} /></span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="container about-cta-wrap">
    <CTA
      title="Have a project you’d like to discuss?"
      description="Share what you are building and I’ll review the right creative, video or web direction."
      primaryHref="/contact/"
      primaryLabel="Start a Project"
      secondaryHref="/work/"
      secondaryLabel="View My Work"
    />
  </div>
</BaseLayout>

<style>
.about-hero{padding-top:1.1rem;background:linear-gradient(180deg,#fff 0%,#fff 72%,var(--color-bg-soft) 72%,var(--color-bg-soft) 100%)}
.about-hero__grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(23rem,.92fr);gap:3.4rem;align-items:center;padding-block:1.35rem 1.7rem}
.about-hero__copy{display:grid;align-content:center;gap:.56rem;min-width:0}.about-hero__copy h1{font-size:clamp(2.85rem,4.8vw,4.35rem);max-width:15ch}.about-hero__role{font-size:clamp(1.25rem,1.9vw,1.65rem);font-weight:650;line-height:1.18;letter-spacing:-.025em}.about-hero__intro{max-width:42rem;color:var(--color-text-muted);font-size:var(--fs-body-lg);line-height:var(--lh-body-tight)}.about-hero__actions{display:flex;flex-wrap:wrap;gap:.72rem;margin-top:.5rem}
.about-hero__media{position:relative;min-height:28rem;border-radius:var(--radius-lg);overflow:visible}.about-hero__media>img{width:100%;height:28rem;object-fit:cover;object-position:center 24%;border-radius:var(--radius-lg);border:var(--border);background:#e7edf1}.about-hero__focus{position:absolute;right:-1.5rem;bottom:2.6rem;width:min(14.6rem,48%);display:grid;gap:.55rem;padding:1rem;background:rgba(255,255,255,.96);backdrop-filter:blur(8px)}.about-hero__focus strong{font-size:1.05rem;line-height:1.18;letter-spacing:-.02em}.about-hero__focus span{display:flex;align-items:center;gap:.42rem;color:#334155;font-size:var(--fs-meta);font-weight:650}.about-hero__focus span :global(svg){color:#0f2743;flex:0 0 auto}
.about-trust{border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);background:#fff}.about-trust__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.about-trust__grid>:global(.trust)+:global(.trust){border-left:1px solid var(--color-border)}
.about-section{padding-block:2.15rem}.about-section--soft{background:var(--color-bg-soft);border-block:1px solid var(--color-border)}.about-split{display:grid;gap:2.2rem;align-items:start}.about-split--story{grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr)}.about-split--principles{grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr)}.about-split--proof{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}
.about-story{display:grid;gap:.52rem}.about-story h2{font-size:clamp(1.75rem,2.5vw,2.45rem);max-width:16ch}.about-story__copy{display:grid;gap:.8rem;margin-top:.28rem}.about-story__copy p{color:#475569;max-width:42rem}
.about-specialization{min-width:0}.about-heading-row{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.8rem}.about-heading-row>div{display:grid;gap:.2rem}.about-heading-row h2,.about-section-heading h2{font-size:clamp(1.55rem,2vw,2rem)}.about-heading-row p,.about-section-heading p{color:var(--color-text-muted);font-size:var(--fs-body-sm)}.about-inline-link{display:inline-flex;align-items:center;gap:.28rem;flex:0 0 auto;min-height:2.5rem;color:#2563eb;font-size:var(--fs-meta);font-weight:750}.about-inline-link:hover{text-decoration:underline;text-underline-offset:.18em}
.about-pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.about-pillar{overflow:hidden;display:grid;grid-template-rows:1fr auto auto;min-width:0;box-shadow:none}.about-pillar__top{display:grid;align-content:start;gap:.34rem;padding:.84rem}.about-pillar__number{display:grid;place-items:center;width:2.15rem;height:2.15rem;border-radius:50%;background:#fff1ed;color:var(--color-brand-strong);font-size:.92rem;font-weight:800}.about-pillar h3{font-size:1.05rem;line-height:1.2}.about-pillar p{color:var(--color-text-muted);font-size:var(--fs-meta);line-height:1.45}.about-pillar>img{width:100%;aspect-ratio:16/7;object-fit:cover;background:#eef2f7}.about-pillar__links{display:flex;flex-wrap:wrap;gap:.2rem .55rem;padding:.54rem .84rem .7rem}.about-pillar__links a{display:inline-flex;align-items:center;gap:.2rem;min-height:2.25rem;color:var(--color-brand-strong);font-size:var(--fs-meta);font-weight:750}.about-pillar__links a:hover{text-decoration:underline;text-underline-offset:.15em}
.about-section-heading{display:grid;gap:.2rem;margin-bottom:.72rem}.about-principles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.56rem}.about-principle,.about-expectation{box-shadow:none}.about-principle{padding:.75rem}.about-icon{display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:#fff1ed;color:var(--color-brand-strong);margin-bottom:.45rem}.about-principle h3,.about-expectation h3{font-size:.98rem;line-height:1.2}.about-principle p,.about-expectation p{margin-top:.28rem;color:var(--color-text-muted);font-size:var(--fs-meta);line-height:1.4}
.about-credibility{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));overflow:hidden;box-shadow:none}.about-credibility__item{display:grid;justify-items:center;align-content:center;gap:.26rem;text-align:center;min-height:8.2rem;padding:.72rem}.about-credibility__item + .about-credibility__item{border-left:1px solid var(--color-border)}.about-credibility__item :global(svg){color:#0f2743}.about-credibility__item strong{font-size:1.05rem;line-height:1.15;letter-spacing:-.02em}.about-credibility__item span{color:var(--color-text-muted);font-size:var(--fs-caption);line-height:1.3}
.about-review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.72rem}.about-work__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.72rem}.about-work :global(.project-card__body){padding:.62rem}.about-work :global(.project-card h3){font-size:1rem}.about-work :global(.project-card__action){font-size:var(--fs-caption)}
.about-bottom-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:1.4rem;align-items:stretch}.about-personal{display:grid;grid-template-columns:9.5rem 1fr;gap:1rem;align-items:center;padding:.9rem;box-shadow:none}.about-personal img{width:9.5rem;height:8.2rem;object-fit:cover;object-position:center 23%;border-radius:var(--radius-md)}.about-personal div{display:grid;gap:.38rem}.about-personal h2{font-size:1.42rem}.about-personal p{color:var(--color-text-muted);font-size:var(--fs-body-sm);line-height:1.5}.about-signoff{margin-top:.2rem;color:#475569;font-size:var(--fs-meta);font-style:italic;font-weight:650}
.about-expectations__grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.52rem}.about-expectation{padding:.68rem;text-align:left}.about-expectation .about-icon{width:1.8rem;height:1.8rem;margin-bottom:.35rem}.about-expectation h3{font-size:.86rem}.about-expectation p{font-size:var(--fs-caption)}
.about-cta-wrap{padding-block:1.15rem 2rem}

@media(max-width:63.99rem){
  .about-hero__grid{grid-template-columns:1fr 1fr;gap:1.6rem}.about-hero__focus{right:.6rem;bottom:1rem;width:min(14rem,62%)}
  .about-split--story,.about-split--principles,.about-split--proof,.about-bottom-grid{grid-template-columns:1fr}.about-principles{grid-template-columns:repeat(2,minmax(0,1fr))}.about-credibility{grid-template-columns:repeat(4,minmax(0,1fr))}.about-expectations__grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}

@media(max-width:47.99rem){
  .about-hero{padding-top:.35rem;background:#fff}.about-hero__grid{display:flex;flex-direction:column-reverse;gap:.8rem;padding-block:.35rem 1rem}.about-hero__media{width:100%;min-height:0}.about-hero__media>img{height:auto;aspect-ratio:16/8.2;object-position:center 24%}.about-hero__focus{display:none}.about-hero__copy{width:100%;gap:.35rem}.about-hero__copy h1{font-size:var(--fs-h1);max-width:none}.about-hero__role{font-size:1.08rem}.about-hero__intro{font-size:var(--fs-body);line-height:1.5}.about-hero__actions{display:grid;grid-template-columns:1fr 1fr;width:100%;gap:.55rem;margin-top:.35rem}.about-hero__actions :global(.button){width:100%;padding-inline:.7rem}.about-trust__grid{grid-template-columns:repeat(3,minmax(0,1fr))}.about-trust__grid>:global(.trust){padding:.68rem .45rem;gap:.35rem}.about-trust__grid>:global(.trust strong){font-size:.94rem}.about-trust__grid>:global(.trust small){font-size:var(--fs-caption);white-space:normal}
  .about-section{padding-block:1.45rem}.about-split{gap:1.35rem}.about-story h2{font-size:1.85rem;max-width:17ch}.about-story__copy{gap:.62rem}.about-story__copy p{font-size:var(--fs-body-sm)}
  .about-heading-row{align-items:start;margin-bottom:.58rem}.about-heading-row p{font-size:var(--fs-meta)}.about-inline-link{min-height:2.25rem;font-size:var(--fs-caption);white-space:nowrap}
  .about-pillars{grid-template-columns:1fr;gap:.45rem}.about-pillar{grid-template-columns:5.9rem minmax(0,1fr);grid-template-rows:auto auto;min-height:6.6rem}.about-pillar__top{grid-column:2;padding:.62rem .68rem .18rem;gap:.18rem}.about-pillar__number{display:none}.about-pillar h3{font-size:.98rem}.about-pillar p{font-size:var(--fs-caption);line-height:1.35}.about-pillar>img{grid-column:1;grid-row:1/3;width:100%;height:100%;aspect-ratio:auto;object-fit:cover}.about-pillar__links{grid-column:2;padding:.12rem .68rem .4rem;gap:0 .48rem}.about-pillar__links a{min-height:2rem;font-size:var(--fs-caption)}
  .about-principles{grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem}.about-principle{padding:.62rem}.about-principle p{font-size:var(--fs-caption)}
  .about-credibility{grid-template-columns:repeat(2,minmax(0,1fr))}.about-credibility__item{min-height:6.7rem;padding:.55rem}.about-credibility__item:nth-child(3){border-left:0;border-top:1px solid var(--color-border)}.about-credibility__item:nth-child(4){border-top:1px solid var(--color-border)}.about-credibility__item strong{font-size:.98rem}
  .about-review-grid{display:grid;grid-auto-flow:column;grid-auto-columns:min(86vw,21rem);grid-template-columns:none;overflow-x:auto;gap:.6rem;padding-bottom:.35rem;scroll-snap-type:x proximity}.about-review-grid>:global(*){scroll-snap-align:start}
  .about-work__grid{display:grid;grid-auto-flow:column;grid-auto-columns:min(86vw,21rem);grid-template-columns:none;overflow-x:auto;gap:.6rem;padding-bottom:.35rem;scroll-snap-type:x proximity}.about-work__grid>:global(*){scroll-snap-align:start}.about-work :global(.project-card){display:block;min-height:0}.about-work :global(.project-card__media){height:auto;aspect-ratio:16/9;border-radius:0}.about-work :global(.project-card__body){padding:.58rem .62rem}.about-work :global(.project-card__dev){display:none}
  .about-personal{grid-template-columns:6.1rem 1fr;gap:.72rem;padding:.7rem}.about-personal img{width:6.1rem;height:6.5rem}.about-personal h2{font-size:1.2rem}.about-personal p{font-size:var(--fs-caption)}
  .about-expectations__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.42rem}.about-expectation{padding:.58rem}.about-expectation:last-child{grid-column:1/-1}.about-cta-wrap{padding-block:.8rem 1.3rem}
}
</style>
