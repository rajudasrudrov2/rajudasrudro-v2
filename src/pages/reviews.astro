---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import TrustMetric from '@/components/TrustMetric.astro';
import CTA from '@/components/CTA.astro';
import { verifiedTrust } from '@/data/site';
import { publicReviewSummaries } from '@/data/reviews';
---
<BaseLayout meta={{ title: 'Client Reviews — Raju Das Rudro', description: 'Public client feedback and Fiverr trust signals for Raju Das Rudro.', pathname: '/reviews/' }}>
  <section class="section"><div class="container reviews-hero"><div class="stack"><p class="eyebrow">Client Reviews</p><h1>What Clients Say</h1><p class="lede">Real feedback from public client profiles and review sources. Review data should remain attributable and never be invented.</p></div><div class="review-metrics surface">{verifiedTrust.map((m,i)=><TrustMetric value={m.value} label={m.label} icon={i===0?'★':'✦'} />)}</div></div></section>
  <section class="section section--soft"><div class="container"><h2>Featured Reviews</h2><div class="grid-2 reviews-grid">{publicReviewSummaries.map(review=><ReviewCard review={review} />)}</div><p class="source-note">Review text above is deliberately summarized in the source code. The CMS model supports exact public review text, source URL, date, country and project context when migrated from the verified public source.</p></div></section>
  <div class="container cta-wrap"><CTA title="Ready to work together?" /></div>
</BaseLayout>
<style>.reviews-hero{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center}.reviews-hero h1{font-size:var(--fs-hero)}.review-metrics{display:grid;grid-template-columns:1fr 1fr}.review-metrics>*+*{border-left:1px solid var(--color-border)}.reviews-grid{margin-top:1rem}.source-note{margin-top:1rem;color:var(--color-text-muted);font-size:.72rem}.cta-wrap{padding-block:1rem 2rem}@media(max-width:47.99rem){.reviews-hero{grid-template-columns:1fr}.reviews-hero h1{font-size:2.4rem}}</style>
