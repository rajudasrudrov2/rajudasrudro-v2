---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import { site, verifiedTrust } from '@/data/site';
import { publicReviewSummaries, reviewsUseCms } from '@/data/reviews';
import { allWorkProjects, featuredWorkProject, workProjects, workUsesCms } from '@/data/work';

const featuredReview = publicReviewSummaries[0];
const remainingReviews = publicReviewSummaries.slice(1);
const allLocalWork = [featuredWorkProject, ...workProjects];
const selectedWorkIds = new Set([
  'work-featured-ai-ugc-preview',
  'work-spokesperson-preview',
  'work-ecommerce-web-preview',
]);
const localSelectedWork = allLocalWork.filter((project) => selectedWorkIds.has(project.id));
const selectFeaturedFirstWork = <T extends { featured?: boolean; sortOrder: number; title: string }>(projects: readonly T[], limit: number): T[] =>
  [...projects]
    .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)) || a.sortOrder - b.sortOrder || a.title.localeCompare(b.title))
    .slice(0, limit);
const cmsSelectedWork = selectFeaturedFirstWork(allWorkProjects, 3);
const selectedWork = workUsesCms ? cmsSelectedWork : localSelectedWork;
const ratingTrust = verifiedTrust.find((item) => item.label === 'Fiverr Rating');
const reviewCountTrust = verifiedTrust.find((item) => item.label === 'Fiverr Reviews');
const aggregateTrustNote = ratingTrust && reviewCountTrust
  ? ` ${ratingTrust.value} ${ratingTrust.label.toLowerCase()} and ${reviewCountTrust.value} ${reviewCountTrust.label.toLowerCase()} are aggregate profile signals, not the number of review cards on this page.`
  : '';
---
<BaseLayout
  meta={{
    title: 'Client Reviews & Fiverr Feedback — Raju Das Rudro',
    description: 'Read accepted public Fiverr review summaries for Raju Das Rudro and explore the verified aggregate Fiverr trust signals used across the site.',
    pathname: '/reviews/',
    image: '/images/raju-das-rudro.webp',
  }}
>
  <section class="reviews-hero" aria-labelledby="reviews-title">
    <div class="container reviews-hero__grid">
      <div class="reviews-hero__copy">
        <p class="eyebrow">Client feedback</p>
        <h1 id="reviews-title">What Clients Say</h1>
        <p class="reviews-hero__lede">
          Public Fiverr review summaries from real client feedback, presented separately from portfolio claims and project-specific results.
        </p>
        <div class="reviews-hero__actions">
          <Button href="/contact/">Start a Project <Icon name="arrow" size={16} /></Button>
          <Button href={site.fiverr} variant="secondary">View Fiverr Profile ↗</Button>
        </div>
      </div>

      <div class="reviews-hero__media surface">
        <img
          src="/images/raju-das-rudro.webp"
          width="635"
          height="640"
          alt="Raju Das Rudro"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="reviews-hero__note">
          <strong>Grateful for every client, project and opportunity.</strong>
          <span>— Raju Das Rudro</span>
        </div>
      </div>
    </div>
  </section>

  <section class="reviews-trust" aria-label="Fiverr trust summary">
    <div class="container reviews-trust__grid surface">
      {verifiedTrust.map((item, index) => (
        <div class="reviews-trust__item">
          <span class="reviews-trust__icon" aria-hidden="true"><Icon name={index === 0 ? 'star' : 'users'} size={24} /></span>
          <span>
            <strong>{item.value}</strong>
            <b>{item.label}</b>
            <small>Aggregate public Fiverr profile signal</small>
          </span>
        </div>
      ))}
    </div>
  </section>

  <section class="reviews-section reviews-section--soft" aria-labelledby="featured-review-title">
    <div class="container">
      <div class="reviews-heading-row">
        <div>
          <h2 id="featured-review-title">Featured Review</h2>
          <p>One accepted public-review summary highlighted from the current source set.</p>
        </div>
        <a href={site.fiverr} class="reviews-inline-link">View Fiverr Profile <Icon name="arrow" size={14} /></a>
      </div>

      {featuredReview ? (
        <div class="reviews-featured">
          <ReviewCard review={featuredReview} />
        </div>
      ) : (
        <div class="reviews-empty surface" role="status">No verified individual review records are currently available.</div>
      )}
    </div>
  </section>

  <section class="reviews-section" aria-labelledby="all-reviews-title">
    <div class="container">
      <div class="reviews-heading-row reviews-heading-row--plain">
        <div>
          <h2 id="all-reviews-title">More Client Reviews</h2>
          <p>{reviewsUseCms ? 'The remaining public review records currently available from the selected source.' : 'The remaining accepted review summaries currently available in the local source.'}</p>
        </div>
      </div>

      {remainingReviews.length ? (
        <div class="reviews-grid">
          {remainingReviews.map((review) => <ReviewCard review={review} />)}
        </div>
      ) : publicReviewSummaries.length ? (
        <p class="reviews-count-note">The featured review above is the only verified individual review record currently available.</p>
      ) : (
        <div class="reviews-empty surface" role="status">No verified individual review records are currently available.</div>
      )}
    </div>
  </section>

  <section class="reviews-section reviews-section--soft" aria-labelledby="reviews-source-title">
    <div class="container reviews-proof-grid">
      <article class="reviews-source surface">
        <span class="reviews-source__icon" aria-hidden="true"><Icon name="check" size={22} /></span>
        <div>
          <h2 id="reviews-source-title">Public Fiverr Review Source</h2>
          <p>
            The individual review summaries shown here come from the accepted public Fiverr source records in the current site data.
            {aggregateTrustNote}
          </p>
          <Button href={site.fiverr} variant="secondary">View Fiverr Profile ↗</Button>
        </div>
      </article>

      <div class="reviews-work" aria-labelledby="reviews-work-title">
        <div class="reviews-heading-row">
          <div>
            <h2 id="reviews-work-title">Explore Selected Work</h2>
            <p>Portfolio examples are shown separately and are not presented as review-to-project mappings.</p>
          </div>
          <a href="/work/" class="reviews-inline-link">View All Work <Icon name="arrow" size={14} /></a>
        </div>
        {selectedWork.length ? (
          <div class="reviews-work__grid">
            {selectedWork.map((project) => <ProjectCard project={project} />)}
          </div>
        ) : (
          <div class="reviews-empty surface" role="status">No public projects are currently available.</div>
        )}
      </div>
    </div>
  </section>

  <div class="container reviews-cta">
    <CTA
      title="Ready to work together?"
      description="Let’s turn your ideas into focused creative work and modern digital experiences."
      secondaryHref="/services/"
      secondaryLabel="Explore Services"
    />
  </div>
</BaseLayout>

<style>
.reviews-hero{background:linear-gradient(180deg,#fff 0%,#fff 72%,#f8fafc 100%);border-bottom:1px solid var(--color-border)}
.reviews-hero__grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(20rem,.98fr);align-items:stretch;gap:2rem;padding-block:1.2rem 1.35rem}
.reviews-hero__copy{align-self:center;display:grid;gap:.7rem;max-width:38rem}.reviews-hero__copy h1{font-size:var(--fs-hero);max-width:34rem}.reviews-hero__lede{max-width:38rem;color:var(--color-text-muted);font-size:var(--fs-body-lg);line-height:var(--lh-body-tight)}
.reviews-hero__actions{display:flex;gap:.65rem;flex-wrap:wrap;margin-top:.2rem}.reviews-hero__media{position:relative;overflow:hidden;min-height:18rem;background:#eef3f6;box-shadow:none}.reviews-hero__media>img{width:100%;height:100%;object-fit:cover;object-position:center 24%}.reviews-hero__note{position:absolute;right:1rem;top:50%;transform:translateY(-50%);display:grid;gap:.25rem;max-width:13rem;padding:.8rem .9rem;border:1px solid rgba(226,232,240,.94);border-radius:var(--radius-md);background:rgba(255,255,255,.94);box-shadow:var(--shadow-card)}.reviews-hero__note strong{font-size:var(--fs-body);line-height:1.3}.reviews-hero__note span{font-size:var(--fs-caption);color:var(--color-text-muted)}
.reviews-trust{background:var(--color-bg-soft);padding-block:.85rem}.reviews-trust__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden;box-shadow:none}.reviews-trust__item{display:flex;align-items:center;justify-content:center;gap:.75rem;padding:.82rem 1rem;min-width:0}.reviews-trust__item+.reviews-trust__item{border-left:1px solid var(--color-border)}.reviews-trust__icon{display:grid;place-items:center;color:#0f2743}.reviews-trust__item>span:last-child{display:grid;line-height:1.18}.reviews-trust__item strong{font-size:1.2rem;letter-spacing:-.025em}.reviews-trust__item b{font-size:var(--fs-meta)}.reviews-trust__item small{font-size:var(--fs-caption);color:var(--color-text-muted);margin-top:.12rem}
.reviews-section{padding-block:1.25rem}.reviews-section--soft{background:var(--color-bg-soft)}.reviews-heading-row{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.72rem}.reviews-heading-row h2{font-size:clamp(1.45rem,2vw,1.8rem)}.reviews-heading-row p{margin-top:.18rem;color:var(--color-text-muted);font-size:var(--fs-body-sm);line-height:1.45}.reviews-inline-link{display:inline-flex;align-items:center;gap:.25rem;min-height:2.4rem;color:#2563eb;font-size:var(--fs-meta);font-weight:700;white-space:nowrap}.reviews-featured{max-width:34rem}.reviews-featured :global(.review-card){min-height:12.4rem;padding:1rem}.reviews-featured :global(.review-card blockquote){font-size:var(--fs-body);line-height:1.55}.reviews-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;max-width:58rem}.reviews-count-note{color:var(--color-text-muted);font-size:var(--fs-body-sm)}.reviews-empty{padding:1rem;color:var(--color-text-muted);font-size:var(--fs-body-sm)}
.reviews-proof-grid{display:grid;grid-template-columns:minmax(18rem,.72fr) minmax(0,1.28fr);gap:1rem;align-items:start}.reviews-source{display:grid;grid-template-columns:auto 1fr;gap:.8rem;padding:1rem;box-shadow:none}.reviews-source__icon{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:50%;background:#ecfdf5;color:#059669}.reviews-source h2{font-size:1.25rem}.reviews-source p{margin:.32rem 0 .78rem;color:var(--color-text-muted);font-size:var(--fs-body-sm);line-height:1.5}.reviews-work__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.reviews-work :global(.project-card__body){padding:.55rem .6rem .68rem}.reviews-work :global(.project-card h3){font-size:1rem}.reviews-work :global(.project-card__action){font-size:var(--fs-meta)}.reviews-work :global(.project-card__tags){min-height:0}
.reviews-cta{padding-block:1rem 1.5rem}
@media(max-width:63.99rem){.reviews-hero__grid{grid-template-columns:1fr .86fr}.reviews-proof-grid{grid-template-columns:1fr}.reviews-work__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:47.99rem){
  .reviews-hero__grid{grid-template-columns:1fr;padding-block:.8rem 1rem;gap:.7rem}.reviews-hero__copy{gap:.48rem}.reviews-hero__copy h1{font-size:var(--fs-h1)}.reviews-hero__lede{font-size:var(--fs-body);line-height:1.5}.reviews-hero__actions{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}.reviews-hero__actions :global(.button){width:100%;padding-inline:.65rem}.reviews-hero__media{display:none}
  .reviews-trust{padding-block:.55rem}.reviews-trust__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reviews-trust__item{align-items:flex-start;justify-content:flex-start;padding:.7rem .6rem;gap:.5rem}.reviews-trust__item strong{font-size:1.05rem}.reviews-trust__item b{font-size:var(--fs-caption)}.reviews-trust__item small{font-size:var(--fs-caption);line-height:1.25}.reviews-trust__icon :global(svg){width:20px;height:20px}
  .reviews-section{padding-block:1rem}.reviews-heading-row{align-items:start;margin-bottom:.6rem}.reviews-heading-row h2{font-size:var(--fs-h2)}.reviews-heading-row p{font-size:var(--fs-body-sm)}.reviews-inline-link{font-size:var(--fs-caption);min-height:2.2rem}.reviews-featured{max-width:none}.reviews-featured :global(.review-card){min-height:0}.reviews-grid{grid-template-columns:1fr;max-width:none}.reviews-proof-grid{gap:.8rem}.reviews-source{grid-template-columns:1fr}.reviews-source__icon{width:2.25rem;height:2.25rem}.reviews-source h2{font-size:1.15rem}.reviews-work__grid{grid-template-columns:1fr}.reviews-work :global(.project-card:nth-child(n+2)){display:none}.reviews-cta{padding-block:.8rem 1rem}
}
</style>
