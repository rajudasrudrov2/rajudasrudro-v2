---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/CTA.astro';
import EmptyState from '@/components/EmptyState.astro';
import Icon from '@/components/Icon.astro';
import { getArticles } from '@/content-or-cms/client';
import { isProductionEnvironment } from '@/config/environment';
import { isArticleRouteEligible } from '@/lib/articles';

const formatArticleDate = (value: string): string => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
};

const articles = await getArticles();
const featuredArticle = articles.find((article) => article.featured) ?? articles[0];
const listingArticles = featuredArticle
  ? articles.filter((article) => article.id !== featuredArticle.id)
  : articles;
const presentCategories = new Set(listingArticles.map((article) => article.category).filter(Boolean) as string[]);
const categories = ['AI UGC', 'AI Video', 'AI Creative', 'Web Design & Development'].filter((category) => presentCategories.has(category));
const initialVisibleCount = 3;
const filtersEnabled = listingArticles.length >= 4 && categories.length >= 2;
const loadMoreEnabled = listingArticles.length > initialVisibleCount;
const featuredIsLinkable = featuredArticle ? isArticleRouteEligible(featuredArticle, isProductionEnvironment) : false;
const featuredHref = featuredArticle && featuredIsLinkable ? `/insights/${featuredArticle.slug}/` : undefined;

const topicCards = [
  {
    icon: 'video' as const,
    title: 'AI UGC & Video Creative',
    description: 'Practical creator-style content, hooks and production thinking.',
    serviceHref: '/services/ai-ugc-video-ads/',
  },
  {
    icon: 'monitor' as const,
    title: 'Web Design & Development',
    description: 'Structure, usability, performance and implementation guidance.',
    serviceHref: '/services/web-design-development/',
  },
  {
    icon: 'spark' as const,
    title: 'AI Creative Workflows',
    description: 'Brief-to-output workflows, iteration and practical creative systems.',
    serviceHref: '/services/ai-video-production/',
  },
];
---
<BaseLayout
  meta={{
    title: 'Insights on AI Creative, UGC & Web — Raju Das Rudro',
    description: 'Practical Insights on AI UGC, AI video and creative production, plus modern web design and development from Raju Das Rudro.',
    pathname: '/insights/',
  }}
>
  <section class="insights-hero" aria-labelledby="insights-title">
    <div class="container insights-hero__grid">
      <div class="insights-hero__copy">
        <p class="eyebrow">Ideas. Experience. Practical guides.</p>
        <h1 id="insights-title">Insights</h1>
        <p>
          Practical ideas, production lessons and useful guidance around AI UGC, AI video, AI creative and modern web development — built from the same disciplines behind my client work.
        </p>
      </div>
      <div class="insights-hero__art" aria-hidden="true">
        <span class="insights-hero__script">Ideas<br />Content<br />Better Brands</span>
        <div class="insights-hero__mug">Good<br />Ideas<br />Better<br />Brands</div>
        <div class="insights-hero__topics"><b>AI &amp; CREATIVITY</b><b>WEB DEVELOPMENT</b><b>CONTENT SYSTEMS</b></div>
      </div>
    </div>
  </section>

  {articles.length > 0 && featuredArticle ? (
    <>
      <section class="insights-featured" aria-labelledby="featured-insight-title">
        <div class="container">
          <article class="insights-featured__card surface">
            <div class="insights-featured__media">
              {featuredArticle.featureImage ? (
                <img
                  src={featuredArticle.featureImage.src}
                  alt={featuredArticle.featureImage.alt}
                  width={featuredArticle.featureImage.width || 1200}
                  height={featuredArticle.featureImage.height || 675}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : <div class="insights-featured__fallback" aria-hidden="true">Insights</div>}
            </div>
            <div class="insights-featured__body">
              <p class="eyebrow">{featuredArticle.category || 'Featured insight'}</p>
              <h2 id="featured-insight-title">{featuredArticle.title}</h2>
              <p>{featuredArticle.excerpt}</p>
              <div class="insights-featured__meta">
                {featuredArticle.developmentPreview && <span>Development preview — not migrated production content</span>}
                {featuredArticle.publishedDate && <time datetime={featuredArticle.publishedDate}>{formatArticleDate(featuredArticle.publishedDate)}</time>}
                {featuredArticle.readingTime && <span>{featuredArticle.readingTime}</span>}
              </div>
              {featuredHref ? (
                <Button href={featuredHref}>{featuredArticle.developmentPreview ? 'Preview Article' : 'Read Article'} <Icon name="arrow" size={16} /></Button>
              ) : (
                <span class="insights-featured__status">Detail article is unavailable for this record until it has an eligible published or controlled preview state.</span>
              )}
            </div>
          </article>
        </div>
      </section>

      <section class="insights-listing" aria-labelledby="insights-list-title" data-insights-listing data-page-size={initialVisibleCount}>
        <div class="container">
          <div class="insights-heading-row">
            <div>
              <h2 id="insights-list-title">Latest Insights</h2>
              <p>Practical articles on AI creative production, content workflows and modern web development.</p>
            </div>
          </div>

          {filtersEnabled && (
            <div class="insights-filters" role="group" aria-label="Filter Insights by category" data-filter-controls>
              <button type="button" class="active" data-insights-filter="all" aria-pressed="true">All</button>
              {categories.map((category) => (
                <button type="button" data-insights-filter={category} aria-pressed="false">{category}</button>
              ))}
            </div>
          )}

          <div class="insights-grid" data-article-grid>
            {listingArticles.map((article) => <ArticleCard article={article} />)}
          </div>

          {(filtersEnabled || loadMoreEnabled) && <p class="visually-hidden" aria-live="polite" data-results-status></p>}

          {loadMoreEnabled && (
            <div class="insights-load-more" data-load-more-wrap>
              <button type="button" class="insights-load-more__button" data-load-more hidden>
                Load More Articles <span aria-hidden="true">↓</span>
              </button>
            </div>
          )}
        </div>
      </section>

      <section class="insights-topics" aria-labelledby="insights-topics-title">
        <div class="container">
          <div class="insights-heading-row">
            <div>
              <h2 id="insights-topics-title">Explore by Topic</h2>
              <p>Three editorial directions aligned with the current service focus.</p>
            </div>
          </div>
          <div class="insights-topics__grid">
            {topicCards.map((topic) => (
              <article class="insights-topic surface">
                <span class="insights-topic__icon" aria-hidden="true"><Icon name={topic.icon} size={22} /></span>
                <div>
                  <h3>{topic.title}</h3>
                  <p>{topic.description}</p>
                  <a href={topic.serviceHref}>Explore related service <Icon name="arrow" size={14} /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="insights-service-bridge">
        <div class="container insights-service-bridge__inner surface">
          <div>
            <h2>Looking for hands-on help instead of just reading?</h2>
            <p>I create AI UGC, AI video content and modern web experiences for brands and businesses.</p>
          </div>
          <Button href="/services/" variant="secondary">Explore Services <Icon name="arrow" size={16} /></Button>
        </div>
      </section>
    </>
  ) : (
    <section class="insights-empty section section--soft" aria-labelledby="insights-empty-title">
      <div class="container">
        <h2 id="insights-empty-title" class="visually-hidden">Insights publication status</h2>
        <EmptyState
          title="Insights content is being prepared"
          description="No production articles are published through the current content adapter yet. Real CMS content will appear here after the approved migration phase."
        />
      </div>
    </section>
  )}

  <div class="container insights-cta">
    <CTA
      title="Have a project in mind?"
      description="Let’s turn your ideas into focused creative work and modern web experiences."
      secondaryHref="/work/"
      secondaryLabel="View My Work"
    />
  </div>

  {(filtersEnabled || loadMoreEnabled) && (
    <script is:inline>
      (() => {
        const root = document.querySelector('[data-insights-listing]');
        if (!(root instanceof HTMLElement)) return;

        const cards = Array.from(root.querySelectorAll('[data-article-card]')).filter((item) => item instanceof HTMLElement);
        const filterButtons = Array.from(root.querySelectorAll('[data-insights-filter]')).filter((item) => item instanceof HTMLButtonElement);
        const loadMore = root.querySelector('[data-load-more]');
        const resultsStatus = root.querySelector('[data-results-status]');
        const pageSize = Number(root.dataset.pageSize || 3);
        let activeCategory = 'all';
        let visibleCount = pageSize;

        const matchesCategory = (card) => activeCategory === 'all' || card.dataset.category === activeCategory;

        const render = () => {
          const matching = cards.filter(matchesCategory);
          cards.forEach((card) => {
            const matchIndex = matching.indexOf(card);
            card.hidden = matchIndex === -1 || matchIndex >= visibleCount;
          });

          filterButtons.forEach((button) => {
            const active = button.dataset.insightsFilter === activeCategory;
            button.classList.toggle('active', active);
            button.setAttribute('aria-pressed', String(active));
          });

          if (resultsStatus instanceof HTMLElement) {
            resultsStatus.textContent = `${Math.min(visibleCount, matching.length)} of ${matching.length} matching articles shown.`;
          }

          if (loadMore instanceof HTMLButtonElement) {
            const hasMore = matching.length > visibleCount;
            if (hasMore) {
              loadMore.hidden = false;
              loadMore.disabled = false;
              loadMore.innerHTML = 'Load More Articles <span aria-hidden="true">↓</span>';
            } else if (document.activeElement === loadMore) {
              loadMore.hidden = false;
              loadMore.disabled = true;
              loadMore.textContent = 'All matching articles shown';
            } else {
              loadMore.hidden = true;
              loadMore.disabled = true;
            }
          }
        };

        filterButtons.forEach((button) => {
          button.addEventListener('click', () => {
            activeCategory = button.dataset.insightsFilter || 'all';
            visibleCount = pageSize;
            render();
          });
        });

        if (loadMore instanceof HTMLButtonElement) {
          loadMore.addEventListener('click', () => {
            visibleCount += pageSize;
            render();
          });
        }

        render();
      })();
    </script>
  )}
</BaseLayout>

<style>
.insights-hero{border-bottom:1px solid var(--color-border);background:linear-gradient(90deg,#fff 0%,#fff 56%,#f5f7f9 100%)}.insights-hero__grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(23rem,.92fr);min-height:14.2rem}.insights-hero__copy{align-self:center;display:grid;gap:.62rem;max-width:40rem;padding-block:1.35rem}.insights-hero__copy h1{font-size:var(--fs-hero)}.insights-hero__copy>p:last-child{max-width:39rem;color:var(--color-text-muted);font-size:var(--fs-body-lg);line-height:1.5}.insights-hero__art{position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:flex-end;gap:.7rem;padding:1.1rem;background:linear-gradient(135deg,#eef3f6,#f8fafc 52%,#e9eef2)}.insights-hero__art::before{content:"";position:absolute;right:12%;top:-1rem;width:8rem;height:12rem;border-radius:45% 55% 40% 60%;background:linear-gradient(160deg,#dfe8de,#a7bea6);filter:blur(.2px);opacity:.85}.insights-hero__script{position:absolute;left:1.4rem;top:2.2rem;z-index:1;transform:rotate(-7deg);font-size:1.15rem;font-style:italic;font-weight:700;line-height:1.08;color:#405268}.insights-hero__mug{position:relative;z-index:1;display:grid;place-content:center;width:7.2rem;height:6.8rem;border-radius:.55rem 1.3rem 1.3rem .55rem;background:#fff;box-shadow:0 12px 30px rgba(15,23,42,.12);font-size:.88rem;font-weight:800;line-height:1.03}.insights-hero__mug::after{content:"";position:absolute;right:-1.55rem;top:1.35rem;width:2.1rem;height:2.5rem;border:.5rem solid #fff;border-left:0;border-radius:0 1.3rem 1.3rem 0}.insights-hero__topics{position:relative;z-index:1;display:grid;gap:.18rem;align-self:center}.insights-hero__topics b{display:block;background:#17283b;color:#fff;padding:.33rem .55rem;font-size:.72rem;line-height:1.05;letter-spacing:.04em}
.insights-featured{padding-block:1.1rem;background:var(--color-bg-soft);border-bottom:1px solid var(--color-border)}.insights-featured__card{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(22rem,.92fr);overflow:hidden;box-shadow:none}.insights-featured__media{min-height:18rem;background:#e8eef3}.insights-featured__media img{width:100%;height:100%;object-fit:cover}.insights-featured__fallback{display:grid;place-items:center;height:100%;font-weight:800;color:#64748b}.insights-featured__body{align-content:center;display:grid;gap:.62rem;padding:1.25rem}.insights-featured__body h2{font-size:clamp(1.55rem,2.2vw,2.05rem)}.insights-featured__body>p:not(.eyebrow){color:var(--color-text-muted);font-size:var(--fs-body);line-height:1.52}.insights-featured__meta{display:flex;flex-wrap:wrap;gap:.55rem;color:var(--color-text-muted);font-size:var(--fs-caption)}.insights-featured__status{display:inline-flex;align-items:center;max-width:26rem;min-height:2.4rem;padding:.45rem .65rem;border:1px dashed #cbd5e1;border-radius:var(--radius-md);color:#64748b;font-size:var(--fs-caption);line-height:1.35}
.insights-listing{padding-block:1.25rem}.insights-heading-row{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:.75rem}.insights-heading-row h2{font-size:clamp(1.45rem,2vw,1.8rem)}.insights-heading-row p{margin-top:.18rem;color:var(--color-text-muted);font-size:var(--fs-body-sm)}.insights-filters{display:none;flex-wrap:wrap;gap:.45rem;margin-bottom:.8rem}.insights-filters button{min-height:2.35rem;padding:.48rem .9rem;border:1px solid var(--color-border);border-radius:var(--radius-md);background:#fff;color:#475569;font-size:var(--fs-meta);font-weight:700;cursor:pointer}.insights-filters button.active{background:var(--color-text);border-color:var(--color-text);color:#fff}:global(html.js) .insights-filters{display:flex}.insights-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.insights-grid :global([hidden]){display:none!important}.insights-load-more{display:none;justify-content:center;padding-top:.9rem}:global(html.js) .insights-load-more{display:flex}.insights-load-more__button{min-height:2.45rem;padding:.55rem 1.2rem;border:1px solid var(--color-brand);border-radius:var(--radius-md);background:#fff;color:var(--color-brand-strong);font-size:var(--fs-meta);font-weight:750;cursor:pointer}.insights-load-more__button:hover{background:#fff7f7}.insights-load-more__button[hidden]{display:none!important}
.insights-topics{padding-block:1.15rem;background:var(--color-bg-soft);border-block:1px solid var(--color-border)}.insights-topics__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.insights-topic{display:grid;grid-template-columns:auto 1fr;gap:.75rem;padding:.9rem;box-shadow:none}.insights-topic__icon{display:grid;place-items:center;width:2.7rem;height:2.7rem;border-radius:50%;background:#fff1f2;color:var(--color-brand-strong)}.insights-topic h3{font-size:1rem}.insights-topic p{margin:.18rem 0 .35rem;color:var(--color-text-muted);font-size:var(--fs-caption);line-height:1.4}.insights-topic a{display:inline-flex;align-items:center;gap:.2rem;min-height:2.1rem;color:var(--color-brand-strong);font-size:var(--fs-caption);font-weight:750}
.insights-service-bridge{padding-block:1rem}.insights-service-bridge__inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.15rem;background:var(--color-bg-soft);box-shadow:none}.insights-service-bridge h2{font-size:1.25rem}.insights-service-bridge p{margin-top:.18rem;color:var(--color-text-muted);font-size:var(--fs-body-sm)}.insights-cta{padding-block:0 1.5rem}
@media(max-width:63.99rem){.insights-hero__grid{grid-template-columns:1.05fr .95fr}.insights-featured__card{grid-template-columns:1.05fr .95fr}.insights-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.insights-topics__grid{grid-template-columns:1fr 1fr}.insights-topic:last-child{grid-column:1/-1}}
@media(max-width:47.99rem){.insights-hero{background:#fff}.insights-hero__grid{grid-template-columns:1fr;min-height:0}.insights-hero__copy{padding-block:.8rem .75rem;gap:.4rem}.insights-hero__copy h1{font-size:var(--fs-h1)}.insights-hero__copy>p:last-child{font-size:var(--fs-body);line-height:1.48}.insights-hero__art{min-height:6.2rem;padding:.7rem;justify-content:flex-end}.insights-hero__script{display:none}.insights-hero__mug{width:5rem;height:4.7rem;font-size:.68rem}.insights-hero__mug::after{display:none}.insights-hero__topics b{font-size:.62rem}.insights-featured{padding-block:.7rem}.insights-featured__card{grid-template-columns:1fr}.insights-featured__media{min-height:0;aspect-ratio:16/9}.insights-featured__body{padding:.8rem;gap:.45rem}.insights-featured__body h2{font-size:1.35rem}.insights-featured__body>p:not(.eyebrow){font-size:var(--fs-body-sm);line-height:1.45}.insights-listing{padding-block:1rem}.insights-heading-row{align-items:start;margin-bottom:.6rem}.insights-heading-row h2{font-size:var(--fs-h2)}.insights-heading-row p{font-size:var(--fs-caption)}.insights-filters{gap:.35rem;overflow-x:auto;flex-wrap:nowrap;padding-bottom:.2rem}.insights-filters button{white-space:nowrap;min-height:2.25rem;padding:.42rem .72rem;font-size:var(--fs-caption)}.insights-grid{grid-template-columns:1fr;gap:.55rem}.insights-load-more{padding-top:.7rem}.insights-load-more__button{width:100%}.insights-topics{padding-block:1rem}.insights-topics__grid{grid-template-columns:1fr;gap:.55rem}.insights-topic:last-child{grid-column:auto}.insights-topic{padding:.72rem}.insights-service-bridge{padding-block:.8rem}.insights-service-bridge__inner{align-items:stretch;flex-direction:column;padding:.85rem}.insights-service-bridge h2{font-size:1.1rem}.insights-service-bridge :global(.button){width:100%}.insights-cta{padding-bottom:1rem}}
</style>
