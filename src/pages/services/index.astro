---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTA from '@/components/CTA.astro';
import { services } from '@/data/services';
---
<BaseLayout meta={{ title: 'Services — Raju Das Rudro', description: 'AI UGC video ads, AI video production, AI spokesperson videos and web design and development.', pathname: '/services/' }}>
  <section class="section services-hero"><div class="container services-hero__grid"><div class="stack"><p class="eyebrow">Services</p><h1>Creative AI &amp; Web Services for Modern Brands.</h1><p class="lede">AI-powered video creative, UGC, spokesperson content and high-performance websites that help brands grow.</p><div class="cluster"><Button href="/contact/">Start a Project →</Button><Button href="/work/" variant="secondary">View My Work</Button></div></div><div class="services-hero__visual surface"><span>AI + UGC + Web</span></div></div></section>
  <section class="section section--soft"><div class="container"><SectionHeader title="Our Core Services" description="Four focused service areas to help you create, grow and stand out." /><div class="grid-4">{services.map(service => <ServiceCard service={service} />)}</div></div></section>
  <section class="section"><div class="container audience"><div class="surface custom"><h2>Have a different AI project in mind?</h2><p>Custom AI-based creative projects are welcome when they fit the broader creative and brand scope.</p><Button href="/contact/" variant="secondary">Tell Me About Your Project →</Button></div><div class="surface who"><h2>Who These Services Are For</h2><div class="audience__items"><span>Ecommerce Brands</span><span>SaaS Companies</span><span>Agencies</span><span>Founders</span><span>Marketing Teams</span><span>Coaches / Experts</span></div></div></div></section>
  <div class="container cta-wrap"><CTA title="Let’s build something that fits your project." /></div>
</BaseLayout>
<style>.services-hero__grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:3rem}.services-hero h1{font-size:var(--fs-hero);max-width:13ch}.services-hero__visual{min-height:21rem;display:grid;place-items:center;background:linear-gradient(135deg,#e2e8f0,#f8fafc)}.services-hero__visual span{font-family:var(--font-display);font-size:2rem;color:#94a3b8}.audience{display:grid;grid-template-columns:1fr 1.5fr;gap:1rem}.audience>div{padding:1.4rem;display:grid;gap:.75rem}.audience h2{font-size:1.4rem}.audience p,.audience span{font-size:.76rem;color:var(--color-text-muted)}.custom .button{justify-self:start}.audience__items{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.audience__items span{border:1px solid var(--color-border);border-radius:var(--radius-md);padding:.8rem;text-align:center;color:#334155}.cta-wrap{padding-block:1rem 2rem}@media(max-width:47.99rem){.services-hero__grid,.audience{grid-template-columns:1fr}.services-hero h1{font-size:2.2rem}.services-hero__visual{min-height:14rem}.services-hero .cluster{display:grid;grid-template-columns:1fr 1fr}.audience__items{grid-template-columns:repeat(2,1fr)}}</style>
