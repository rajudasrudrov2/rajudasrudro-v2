---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---
<BaseLayout meta={{ title: 'Page Not Found — Raju Das Rudro', description: 'The page you requested does not exist.', pathname: '/404/', noindex: true }}><section class="section not-found"><div class="container"><div class="surface not-found__card"><p class="eyebrow">Error 404</p><strong>404</strong><h1>Page Not Found</h1><p>The page you’re looking for doesn’t exist or may have moved.</p><div class="cluster"><Button href="/">Go Home</Button><Button href="/work/" variant="secondary">View My Work</Button></div></div></div></section></BaseLayout>
<style>.not-found{min-height:65vh;display:grid;place-items:center}.not-found__card{display:grid;place-items:center;text-align:center;gap:.6rem;padding:3rem 1.5rem}.not-found__card>strong{font-family:var(--font-display);font-size:5rem;line-height:1;color:var(--color-text)}.not-found__card p:not(.eyebrow){color:var(--color-text-muted)}</style>
