---
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import type { WorkProject } from '@/types/content';

const { project } = Astro.props as { project: WorkProject };
const hasDetail = project.caseStudyStatus === 'available' && Boolean(project.detailHref);
---
<section class="featured-project" aria-labelledby="featured-project-title">
  <div class="featured-project__media surface">
    {project.poster ? (
      <img
        src={project.poster.src}
        width={project.poster.width || 1200}
        height={project.poster.height || 675}
        alt={project.poster.alt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    ) : <div class="featured-project__fallback" aria-hidden="true"></div>}
    {project.developmentPreview && <span class="featured-project__dev">Development preview</span>}
  </div>

  <div class="featured-project__content">
    <p class="featured-project__label">Featured Project</p>
    <h2 id="featured-project-title">{project.title}</h2>
    <div class="featured-project__tags">
      {project.tags?.map((tag) => <Chip tone={tag.tone || 'neutral'}>{tag.label}</Chip>)}
    </div>
    <p>{project.shortSummary}</p>
    {project.previewHighlights?.length ? (
      <ul>
        {project.previewHighlights.map((item) => <li><Icon name="check" size={14} /><span>{item}</span></li>)}
      </ul>
    ) : null}
    {hasDetail ? (
      <a class="featured-project__action" href={project.detailHref}>View Project <Icon name="arrow" size={15} /></a>
    ) : (
      <span class="featured-project__pending">Case study pending verified migration</span>
    )}
  </div>

  <aside class="featured-project__note surface" aria-label="Portfolio positioning">
    <span class="featured-project__note-icon" aria-hidden="true"><Icon name="spark" size={22} /></span>
    <strong>Helping brands turn ideas into clear content and digital experiences.</strong>
    <span aria-hidden="true" class="featured-project__note-line"></span>
    <small>AI UGC · AI Video · Web Design · Web Development</small>
  </aside>
</section>

<style>
.featured-project{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(17rem,1.05fr) minmax(14rem,.82fr);gap:1rem;align-items:stretch}
.featured-project__media{position:relative;overflow:hidden;aspect-ratio:16/9;box-shadow:none}
.featured-project__media img{width:100%;height:100%;object-fit:cover}
.featured-project__fallback{width:100%;height:100%;background:#eef2f7}
.featured-project__dev{position:absolute;left:.65rem;top:.65rem;padding:.24rem .42rem;border-radius:.28rem;background:rgba(255,255,255,.93);border:1px solid rgba(226,232,240,.9);color:#475569;font-size:.53rem;font-weight:750;letter-spacing:.04em;text-transform:uppercase}
.featured-project__content{display:grid;align-content:center;gap:.5rem;padding:.2rem .15rem}
.featured-project__label{font-size:.58rem;line-height:1;color:var(--color-brand-strong);font-weight:800;letter-spacing:.08em;text-transform:uppercase}
.featured-project__content h2{font-size:1.28rem;line-height:1.06;letter-spacing:-.035em}
.featured-project__tags{display:flex;flex-wrap:wrap;gap:.32rem}
.featured-project__tags :global(.chip){min-height:1.5rem;padding:.2rem .45rem;font-size:.55rem}
.featured-project__content>p:not(.featured-project__label){font-size:.68rem;line-height:1.48;color:var(--color-text-muted)}
.featured-project__content ul{list-style:none;display:grid;gap:.3rem;color:#526072}
.featured-project__content li{display:flex;gap:.42rem;align-items:flex-start;font-size:.62rem;line-height:1.38}
.featured-project__content li :global(svg){color:#0f2743;flex:0 0 auto;margin-top:.05rem}
.featured-project__action{display:inline-flex;align-items:center;gap:.25rem;justify-self:start;margin-top:.15rem;padding:.55rem .78rem;border-radius:var(--radius-md);background:var(--color-brand-strong);color:#fff;font-size:.68rem;font-weight:750}
.featured-project__pending{justify-self:start;margin-top:.12rem;color:#64748b;font-size:.6rem;font-weight:650}
.featured-project__note{display:grid;align-content:center;gap:.7rem;padding:1.25rem 1rem;background:#fbfbfa;box-shadow:none;overflow:hidden}
.featured-project__note-icon{width:2rem;height:2rem;border-radius:50%;display:grid;place-items:center;background:#fff1f2;color:var(--color-brand-strong)}
.featured-project__note strong{font-size:1rem;line-height:1.15;letter-spacing:-.025em;max-width:12rem}
.featured-project__note-line{width:1.2rem;height:2px;background:var(--color-brand)}
.featured-project__note small{font-size:.58rem;line-height:1.45;color:var(--color-text-muted)}

@media(max-width:63.99rem){.featured-project{grid-template-columns:minmax(0,1.25fr) minmax(16rem,.9fr)}.featured-project__note{display:none}}
@media(max-width:47.99rem){
  .featured-project{grid-template-columns:1fr;gap:.55rem}
  .featured-project__media{border-radius:.5rem}
  .featured-project__content{gap:.32rem}
  .featured-project__content h2{font-size:.96rem}
  .featured-project__content>p:not(.featured-project__label),.featured-project__content ul{display:none}
  .featured-project__label{font-size:.52rem}
  .featured-project__tags :global(.chip){min-height:1.3rem;font-size:.5rem;padding:.15rem .35rem}
  .featured-project__pending{font-size:.56rem;color:var(--color-brand-strong)}
}
</style>
