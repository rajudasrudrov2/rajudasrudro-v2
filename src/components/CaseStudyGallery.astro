---
import CaseStudyMedia from './CaseStudyMedia.astro';
import type { CaseStudyHighlight, CaseStudyMediaItem } from '@/types/content';

const { items = [], highlights = [], developmentPreview = false } = Astro.props as {
  items?: CaseStudyMediaItem[];
  highlights?: CaseStudyHighlight[];
  developmentPreview?: boolean;
};
---
{items.length > 0 && (
  <section class="case-gallery" aria-labelledby="case-gallery-title">
    <div class="container">
      <div class="case-section-heading">
        <h2 id="case-gallery-title">Final Creative</h2>
        <p>Media items render only from structured project data; real video controls appear only when a source exists.</p>
      </div>
      <div class:list={{ 'case-gallery__layout': true, 'case-gallery__layout--no-highlights': highlights.length === 0 }}>
        <div class="case-gallery__items" aria-label="Project creative variations">
          {items.map((item) => (
            <article class="case-gallery-card surface">
              <CaseStudyMedia poster={item.poster} video={item.video} developmentPreview={developmentPreview} ariaLabel={`${item.title} project media`} />
              <div class="case-gallery-card__copy">
                <h3>{item.title}</h3>
                {item.subtitle && <p>{item.subtitle}</p>}
              </div>
            </article>
          ))}
        </div>
        {highlights.length > 0 && (
          <aside class="case-highlights" aria-labelledby="case-highlights-title">
            <h3 id="case-highlights-title">Project Highlights</h3>
            <div class="case-highlights__list">
              {highlights.map((highlight) => (
                <article class="case-highlight surface">
                  {highlight.media && <img src={highlight.media.src} alt={highlight.media.alt} width={highlight.media.width || 800} height={highlight.media.height || 450} loading="lazy" decoding="async" />}
                  <strong>{highlight.title}</strong>
                </article>
              ))}
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>
)}
<style>
.case-gallery{padding-block:.95rem;border-top:1px solid var(--color-border)}
.case-section-heading{display:grid;gap:.15rem;margin-bottom:.55rem}.case-section-heading h2{font-size:var(--fs-h2)}.case-section-heading p{font-size:var(--fs-body-sm);color:var(--color-text-muted)}
.case-gallery__layout{display:grid;grid-template-columns:minmax(0,3.25fr) minmax(12rem,1fr);gap:1rem;align-items:start}.case-gallery__layout--no-highlights{grid-template-columns:1fr}
.case-gallery__items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}
.case-gallery-card{overflow:hidden;box-shadow:none}.case-gallery-card :global(.case-media){border:0;border-radius:0;aspect-ratio:4/5}.case-gallery-card__copy{display:grid;gap:.08rem;padding:.48rem .55rem .55rem}.case-gallery-card h3{font-size:var(--fs-card-title)}.case-gallery-card p{font-size:var(--fs-meta);color:var(--color-text-muted)}
.case-highlights{display:grid;gap:.4rem}.case-highlights>h3{font-size:var(--fs-card-title)}.case-highlights__list{display:grid;gap:.48rem}.case-highlight{display:grid;grid-template-columns:5rem minmax(0,1fr);align-items:center;gap:.55rem;overflow:hidden;box-shadow:none}.case-highlight img{width:5rem;height:3.6rem;object-fit:cover}.case-highlight strong{padding-right:.55rem;font-size:var(--fs-meta);line-height:1.25}
@media(max-width:63.99rem){.case-gallery__layout{grid-template-columns:1fr}.case-highlights{display:none}}
@media(max-width:47.99rem){.case-gallery{padding-block:.82rem}.case-section-heading h2{font-size:1.45rem}.case-section-heading p{font-size:var(--fs-body-sm)}.case-gallery__items{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:.55rem;padding-bottom:.2rem;scrollbar-width:thin}.case-gallery-card{flex:0 0 88%;scroll-snap-align:start}.case-gallery-card__copy{padding:.45rem .5rem}.case-gallery-card h3{font-size:1rem}.case-gallery-card p{font-size:var(--fs-meta)}}
</style>
