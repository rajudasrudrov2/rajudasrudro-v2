---
import type { MediaAsset, VideoAsset } from '@/types/content';

const {
  poster,
  video,
  priority = false,
  developmentPreview = false,
  ariaLabel = 'Project media',
} = Astro.props as {
  poster?: MediaAsset;
  video?: VideoAsset;
  priority?: boolean;
  developmentPreview?: boolean;
  ariaLabel?: string;
};

const playable = Boolean(video?.url);
const fallbackPoster = video?.poster || poster;
---
<div class="case-media surface" data-case-media>
  {fallbackPoster ? (
    <img
      src={fallbackPoster.src}
      alt={fallbackPoster.alt}
      width={fallbackPoster.width || 1200}
      height={fallbackPoster.height || 675}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
    />
  ) : (
    <div class="case-media__fallback" role="img" aria-label="Project media unavailable">Media unavailable</div>
  )}

  {playable && (
    <button
      class="case-media__play"
      type="button"
      aria-label={`Play ${ariaLabel}`}
      data-case-video-trigger
      data-video-src={video?.url}
      data-captions-src={video?.captionsUrl}
    >
      <span aria-hidden="true">▶</span>
    </button>
  )}

  {developmentPreview && !playable && (
    <span class="case-media__state">Development media preview</span>
  )}

  {playable && (
    <div class="case-media__player" data-case-video-player hidden>
      <video controls preload="none" playsinline aria-label={ariaLabel}></video>
      <button type="button" class="case-media__close" data-case-video-close>Close video</button>
    </div>
  )}
</div>

<style>
.case-media{position:relative;overflow:hidden;aspect-ratio:16/9;background:#eef2f7;box-shadow:none}
.case-media>img{width:100%;height:100%;object-fit:cover}
.case-media__fallback{width:100%;height:100%;display:grid;place-items:center;color:#64748b;background:#eef2f7;font-size:var(--fs-meta);font-weight:650}
.case-media__play{position:absolute;left:50%;top:50%;width:3.2rem;height:3.2rem;transform:translate(-50%,-50%);display:grid;place-items:center;border-radius:50%;border:2px solid rgba(255,255,255,.95);background:rgba(15,23,42,.7);color:#fff;cursor:pointer;transition:transform var(--transition),background var(--transition)}
.case-media__play:hover{transform:translate(-50%,-50%) scale(1.05);background:rgba(15,23,42,.88)}
.case-media__state{position:absolute;right:.65rem;bottom:.65rem;padding:.28rem .45rem;border-radius:.35rem;background:rgba(15,23,42,.78);color:#fff;font-size:var(--fs-caption);font-weight:750;letter-spacing:.03em;text-transform:uppercase}
.case-media__player{position:absolute;inset:0;z-index:3;display:grid;grid-template-rows:1fr auto;gap:.45rem;padding:.5rem;background:#020617}
.case-media__player[hidden]{display:none}
.case-media__player video{width:100%;height:100%;object-fit:contain;background:#020617;border-radius:.4rem}
.case-media__close{justify-self:end;min-height:2.55rem;padding:.48rem .75rem;border:1px solid rgba(255,255,255,.55);border-radius:.38rem;background:#111827;color:#fff;font-size:var(--fs-meta);font-weight:700;cursor:pointer}
@media(max-width:47.99rem){.case-media__play{width:2.7rem;height:2.7rem}.case-media__state{font-size:var(--fs-caption);right:.45rem;bottom:.45rem}.case-media{border-radius:.55rem}}
</style>
