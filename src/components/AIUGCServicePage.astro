---
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import CTA from './CTA.astro';
import FAQ from './FAQ.astro';
import HomeReviewPlaceholder from './HomeReviewPlaceholder.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import ReviewCard from './ReviewCard.astro';
import TrustMetric from './TrustMetric.astro';
import { homeTrustMetrics, reviewMigrationPlaceholder } from '@/data/home';
import { publicReviewSummaries } from '@/content-or-cms/selected/reviews';
import { featuredWorkProject, workProjects } from '@/data/work';
import type { ServiceDefinition } from '@/data/services';

const { service } = Astro.props as { service: ServiceDefinition };
const detail = service.detail;
if (!detail || detail.kind !== 'ai-ugc') {
  throw new Error('AIUGCServicePage requires the AI UGC service detail record.');
}

const allWork = [featuredWorkProject, ...workProjects];
const selectedAiUgcWork = allWork
  .filter((project) => project.categories.includes('AI UGC'))
  .slice(0, 4);
const caseStudyProject = selectedAiUgcWork.find(
  (project) => project.caseStudyStatus === 'available' && Boolean(project.detailHref),
);
const reviewItems = publicReviewSummaries.slice(0, 2);
const hasSelectedAiUgcWork = selectedAiUgcWork.length > 0;
const hasSparseSelectedAiUgcWork = selectedAiUgcWork.length > 0 && selectedAiUgcWork.length < 3;
const hasExpandedProcess = detail.process.length > 4;
---
<div class="aiugc-page">
  <section class="aiugc-top" aria-labelledby="aiugc-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: service.title, href: service.href }]} />

      <div class="aiugc-top__grid">
        <div class="aiugc-hero-block">
          <div class="aiugc-hero__copy">
            <p class="eyebrow">{detail.eyebrow}</p>
            <h1 id="aiugc-title">{detail.heroTitle}</h1>
            <p class="aiugc-hero__lede">{detail.heroDescription}</p>
            <div class="aiugc-hero__actions">
              <Button href="/contact/">Start a Project <Icon name="arrow" size={16} /></Button>
              <Button href="/work/" variant="secondary">View AI UGC Work</Button>
            </div>
          </div>

          <div class="aiugc-hero-media" role="group" aria-label="Development preview media illustrating AI UGC creative formats">
            <span class="aiugc-preview-label">Development preview media</span>
            {detail.heroMedia.map((media, index) => (
              <figure class:list={['aiugc-hero-media__item', 'surface', { 'aiugc-hero-media__item--main': index === 0 }]}>
                <img
                  src={media.src}
                  alt={media.alt}
                  width={media.width}
                  height={media.height}
                  loading={index === 0 ? 'eager' : undefined}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        </div>

        <aside class="aiugc-explainer" aria-labelledby="aiugc-explainer-title">
          <div class="aiugc-section-heading">
            <h2 id="aiugc-explainer-title">{detail.explanation.title}</h2>
            <p>{detail.explanation.description}</p>
          </div>
          <div class="aiugc-explainer__cards">
            {detail.explanation.comparisons.map((item) => (
              <article class="aiugc-compare surface">
                <img src={item.media.src} alt={item.media.alt} width={item.media.width} height={item.media.height} loading="lazy" decoding="async" />
                <div><h3>{item.title}</h3><p>{item.description}</p></div>
              </article>
            ))}
          </div>
        </aside>

        <div class="aiugc-trust surface" aria-label="Accepted trust indicators">
          {homeTrustMetrics.map((metric) => <TrustMetric {...metric} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="aiugc-section aiugc-needs-get" aria-label="Brand needs and AI UGC deliverables">
    <div class="container aiugc-needs-get__grid">
      <div>
        <div class="aiugc-section-heading aiugc-section-heading--compact">
          <h2>Built for Brands That Need…</h2>
          <p>Practical reasons teams use creator-style AI UGC in a modern creative workflow.</p>
        </div>
        <div class="aiugc-needs-grid">
          {detail.buyerNeeds.map((item) => (
            <article class="aiugc-need surface">
              <span class="aiugc-need__icon" aria-hidden="true"><Icon name={item.icon} size={24} /></span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="aiugc-get">
        <div class="aiugc-section-heading aiugc-section-heading--compact">
          <h2>What You Get</h2>
          <p>A done-for-you creative production scope that can be shaped around the approved brief.</p>
        </div>
        <ul class="aiugc-checklist">
          {detail.deliverables.map((item) => (
            <li><span aria-hidden="true"><Icon name="check" size={16} /></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="aiugc-section aiugc-formats-section" aria-labelledby="aiugc-formats-title">
    <div class="container">
      <div class="aiugc-section-heading aiugc-section-heading--with-link">
        <div><h2 id="aiugc-formats-title">AI UGC Video Formats</h2><p>Different structures for different briefs, offers and creative directions.</p></div>
        <a href="/contact/">Discuss a format <Icon name="arrow" size={15} /></a>
      </div>
      <div class="aiugc-formats" role="list">
        {detail.formats.map((format) => (
          <article class="aiugc-format surface" role="listitem">
            <img src={format.media.src} alt={format.media.alt} width={format.media.width} height={format.media.height} loading="lazy" decoding="async" />
            <div><h3>{format.title}</h3><p>{format.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="aiugc-section aiugc-work-variations" aria-label="Selected AI UGC work and creative variations">
    <div class:list={['container', 'aiugc-work-variations__grid', { 'aiugc-work-variations__grid--no-work': !hasSelectedAiUgcWork, 'aiugc-work-variations__grid--sparse-work': hasSparseSelectedAiUgcWork }]}>
      {hasSelectedAiUgcWork && (
        <div class="aiugc-work-column">
          <div class="aiugc-section-heading aiugc-section-heading--with-link">
            <div><h2>Selected AI UGC Work</h2><p>Existing structured Work records related to AI UGC. Development-preview status remains explicit.</p></div>
            <a href="/work/">View All Work <Icon name="arrow" size={15} /></a>
          </div>
          <div class="aiugc-work-grid">
            {selectedAiUgcWork.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      )}

      <div class="aiugc-variations-column">
        <div class="aiugc-section-heading aiugc-section-heading--compact">
          <h2>Creative Variations</h2>
          <p>One core direction can support multiple openings and visual approaches without pretending those previews are verified campaigns.</p>
        </div>
        <div class="aiugc-variations">
          {detail.variations.map((item, index) => (
            <article class="aiugc-variation surface">
              <img src={item.media.src} alt={item.media.alt} width={item.media.width} height={item.media.height} loading="lazy" decoding="async" />
              <div><span>{index === 0 ? 'Core' : `0${index}`}</span><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="aiugc-section aiugc-process-why" aria-label="Production process and reasons to work with Raju">
    <div class:list={['container', 'aiugc-process-why__grid', { 'aiugc-process-why__grid--expanded': hasExpandedProcess }]}>
      <div>
        <div class="aiugc-section-heading aiugc-section-heading--compact">
          <h2>A Simple Production Process</h2>
          <p>{detail.process.length} clear steps from brief to delivery.</p>
        </div>
        <div class="aiugc-process-grid">
          {detail.process.map((step) => (
            <article class="aiugc-process-step surface">
              <strong>{step.number}</strong>
              <div><h3>{step.title}</h3><p>{step.description}</p></div>
            </article>
          ))}
        </div>
      </div>

      <div>
        <div class="aiugc-section-heading aiugc-section-heading--compact">
          <h2>Why Work With Raju?</h2>
          <p>Service qualities grounded in the accepted positioning and workflow.</p>
        </div>
        <div class="aiugc-why-grid">
          {detail.whyRaju.map((item) => (
            <article class="aiugc-why surface">
              <span aria-hidden="true"><Icon name={item.icon} size={22} /></span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="aiugc-section aiugc-proof-case" aria-label="Client reviews and case study bridge">
    <div class="container aiugc-proof-case__grid">
      <div>
        <div class="aiugc-section-heading aiugc-section-heading--with-link">
          <div><h2>Client Reviews</h2><p>Accepted public-review summaries. They are not presented as project-specific testimonials.</p></div>
          <a href="/reviews/">Read More Reviews <Icon name="arrow" size={15} /></a>
        </div>
        <div class="aiugc-reviews-grid">
          {reviewItems.map((review) => <ReviewCard review={review} />)}
          <HomeReviewPlaceholder item={reviewMigrationPlaceholder} />
        </div>
      </div>

      <div>
        <div class="aiugc-section-heading aiugc-section-heading--with-link">
          <div><h2>Featured Case Study</h2><p>Current reusable Case Study architecture.</p></div>
          <a href="/work/">View Work <Icon name="arrow" size={15} /></a>
        </div>
        {caseStudyProject ? (
          <article class="aiugc-case surface">
            {caseStudyProject.poster && <img src={caseStudyProject.poster.src} alt={caseStudyProject.poster.alt} width={caseStudyProject.poster.width || 1200} height={caseStudyProject.poster.height || 675} loading="lazy" decoding="async" />}
            <div class="aiugc-case__body">
              <span>Development preview case study</span>
              <h3>{caseStudyProject.title}</h3>
              <p>{caseStudyProject.shortSummary}</p>
              {caseStudyProject.detailHref && <a href={caseStudyProject.detailHref}>View Development Case Study <Icon name="arrow" size={15} /></a>}
            </div>
          </article>
        ) : (
          <article class="aiugc-case aiugc-case--empty surface">
            <h3>Case study migration pending</h3>
            <p>No production-ready AI UGC Case Study is currently mapped.</p>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="aiugc-section aiugc-faq-custom" aria-label="Frequently asked questions and custom AI UGC requirements">
    <div class="container aiugc-faq-custom__grid">
      <div>
        <div class="aiugc-section-heading aiugc-section-heading--compact"><h2>Frequently Asked Questions</h2><p>Clear answers about scope, production and delivery.</p></div>
        <FAQ items={detail.faqs} />
      </div>
      <aside class="aiugc-custom surface">
        <span class="aiugc-custom__icon" aria-hidden="true"><Icon name="spark" size={27} /></span>
        <div><h2>{detail.customRequirement.title}</h2><p>{detail.customRequirement.description}</p><Button href="/contact/" variant="secondary">Discuss Your Project <Icon name="arrow" size={15} /></Button></div>
      </aside>
    </div>
  </section>

  <div class="container aiugc-final-cta">
    <CTA
      title="Ready to create AI UGC for your brand?"
      description="Share the product, audience and creative goal and I’ll review the clearest next step."
      primaryHref="/contact/"
      primaryLabel="Start a Project"
      secondaryHref="/work/"
      secondaryLabel="View More Work"
    />
  </div>
</div>

<style>
.aiugc-page{background:#fff}.aiugc-top{padding-block:1rem 1.1rem}.aiugc-top :global(.breadcrumbs){margin-bottom:.85rem}.aiugc-top__grid{display:grid;grid-template-columns:minmax(0,2.05fr) minmax(18rem,.88fr);gap:1.3rem;align-items:start}.aiugc-hero-block{display:grid;grid-template-columns:minmax(18rem,.84fr) minmax(22rem,1.16fr);gap:1.25rem;align-items:center}.aiugc-hero__copy{display:grid;gap:.72rem;align-content:center}.aiugc-hero__copy h1{font-size:clamp(2.35rem,3.45vw,3.75rem);max-width:12ch;line-height:1.02;letter-spacing:-.045em}.aiugc-hero__lede{font-size:var(--fs-body);line-height:var(--lh-body-tight);color:var(--color-text-muted);max-width:36rem}.aiugc-hero__actions{display:flex;gap:.65rem;flex-wrap:wrap;margin-top:.12rem}.aiugc-hero__actions .button{min-width:9.6rem}.aiugc-hero-media{position:relative;display:grid;grid-template-columns:1.15fr .9fr .9fr;gap:.55rem;min-width:0}.aiugc-preview-label{position:absolute;z-index:3;right:.45rem;top:.45rem;padding:.25rem .4rem;border-radius:.32rem;border:1px solid rgba(226,232,240,.9);background:rgba(255,255,255,.94);color:#475569;font-size:var(--fs-caption);font-weight:750;line-height:1.15}.aiugc-hero-media__item{margin:0;overflow:hidden;aspect-ratio:.72;box-shadow:none;background:#eef2f7}.aiugc-hero-media__item img{width:100%;height:100%;object-fit:cover}.aiugc-hero-media__item--main{aspect-ratio:.74}.aiugc-explainer{display:grid;gap:.72rem;padding-left:.1rem}.aiugc-section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:.75rem}.aiugc-section-heading>div{display:grid;gap:.18rem}.aiugc-section-heading h2{font-size:clamp(1.4rem,1.75vw,1.7rem);line-height:1.08}.aiugc-section-heading p{font-size:var(--fs-body-sm);line-height:1.45;color:var(--color-text-muted);max-width:44rem}.aiugc-section-heading--compact{display:grid;justify-content:stretch;align-items:start;gap:.15rem}.aiugc-section-heading--with-link>a{display:inline-flex;align-items:center;gap:.28rem;flex:0 0 auto;color:#2563eb;font-size:var(--fs-meta);font-weight:700}.aiugc-explainer__cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.aiugc-compare{overflow:hidden;box-shadow:none}.aiugc-compare img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#eef2f7}.aiugc-compare>div{display:grid;gap:.18rem;padding:.65rem}.aiugc-compare h3{font-size:1rem;line-height:1.22}.aiugc-compare p{font-size:var(--fs-body-sm);line-height:1.45;color:var(--color-text-muted)}
.aiugc-trust{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));overflow:hidden;box-shadow:none;background:#fbfcfd}.aiugc-trust> :global(.trust){border-right:1px solid var(--color-border)}.aiugc-trust> :global(.trust:last-child){border-right:0}
.aiugc-section{padding-block:1.35rem}.aiugc-needs-get{border-bottom:1px solid #f0f2f4}.aiugc-needs-get__grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(19rem,.9fr);gap:1.3rem}.aiugc-needs-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.aiugc-need{display:grid;justify-items:center;text-align:center;gap:.25rem;padding:.85rem .55rem;box-shadow:none}.aiugc-need__icon{display:grid;place-items:center;color:#193554}.aiugc-need h3{font-size:1rem;line-height:1.2}.aiugc-need p{font-size:var(--fs-body-sm);line-height:1.42;color:var(--color-text-muted)}.aiugc-get{min-width:0}.aiugc-checklist{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.42rem .8rem;list-style:none}.aiugc-checklist li{display:flex;align-items:flex-start;gap:.42rem;font-size:var(--fs-body-sm);line-height:1.42;color:#334155}.aiugc-checklist li>span:first-child{display:grid;place-items:center;width:1.15rem;height:1.15rem;flex:0 0 1.15rem;margin-top:.08rem;border-radius:50%;background:#fff0ee;color:var(--color-brand-strong)}
.aiugc-formats-section{background:#fbfcfd;border-bottom:1px solid #f0f2f4}.aiugc-formats{display:grid;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));gap:.55rem}.aiugc-format{min-width:0;overflow:hidden;box-shadow:none}.aiugc-format img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#eef2f7}.aiugc-format>div{display:grid;gap:.14rem;padding:.55rem}.aiugc-format h3{font-size:1rem;line-height:1.18;overflow-wrap:anywhere}.aiugc-format p{font-size:var(--fs-body-sm);line-height:1.4;color:var(--color-text-muted)}
.aiugc-work-variations__grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(20rem,.75fr);gap:1.25rem;align-items:start}.aiugc-work-variations__grid>*,.aiugc-work-column,.aiugc-variations-column{min-width:0}.aiugc-work-variations__grid--no-work{grid-template-columns:1fr}.aiugc-work-variations__grid--sparse-work{grid-template-columns:repeat(2,minmax(0,1fr))}.aiugc-work-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.55rem}.aiugc-work-grid> :global(.project-card){height:100%;min-width:0}.aiugc-variations{display:grid;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));gap:.45rem}.aiugc-variation{min-width:0;overflow:hidden;box-shadow:none}.aiugc-variation img{width:100%;aspect-ratio:4/5;object-fit:cover;background:#eef2f7}.aiugc-variation>div{display:grid;gap:.12rem;padding:.52rem}.aiugc-variation span{color:var(--color-brand-strong);font-size:var(--fs-caption);font-weight:800;text-transform:uppercase}.aiugc-variation h3{font-size:1rem;line-height:1.18;overflow-wrap:anywhere}.aiugc-variation p{font-size:var(--fs-body-sm);line-height:1.4;color:var(--color-text-muted)}
.aiugc-process-why{background:#fbfcfd;border-block:1px solid #f0f2f4}.aiugc-process-why__grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(19rem,.65fr);gap:1.25rem;align-items:start}.aiugc-process-why__grid>div{min-width:0}.aiugc-process-why__grid--expanded{grid-template-columns:1fr}.aiugc-process-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(10.5rem,1fr));align-items:stretch;gap:.55rem}.aiugc-process-step{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.55rem;align-items:start;min-width:0;padding:.72rem;box-shadow:none}.aiugc-process-step>strong{font-size:1.45rem;line-height:1;color:var(--color-brand-strong)}.aiugc-process-step div{display:grid;gap:.1rem;min-width:0}.aiugc-process-step h3{font-size:1rem;line-height:1.2;overflow-wrap:anywhere}.aiugc-process-step p{font-size:var(--fs-body-sm);line-height:1.4;color:var(--color-text-muted);overflow-wrap:anywhere}.aiugc-why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.45rem}.aiugc-why{display:grid;justify-items:center;text-align:center;gap:.22rem;min-width:0;padding:.7rem .45rem;box-shadow:none}.aiugc-why>span{color:#193554}.aiugc-why h3{font-size:1rem;line-height:1.2;overflow-wrap:anywhere}.aiugc-why p{font-size:var(--fs-body-sm);line-height:1.4;color:var(--color-text-muted);overflow-wrap:anywhere}
.aiugc-proof-case__grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(20rem,.75fr);gap:1.25rem}.aiugc-reviews-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.aiugc-case{display:grid;grid-template-columns:minmax(8rem,.9fr) minmax(0,1.1fr);overflow:hidden;box-shadow:none}.aiugc-case>img{width:100%;height:100%;object-fit:cover;background:#eef2f7}.aiugc-case__body{display:grid;align-content:center;gap:.28rem;padding:.75rem}.aiugc-case__body>span{font-size:var(--fs-caption);font-weight:750;color:var(--color-brand-strong);text-transform:uppercase}.aiugc-case__body h3{font-size:1rem;line-height:1.2}.aiugc-case__body p{font-size:var(--fs-body-sm);line-height:1.42;color:var(--color-text-muted)}.aiugc-case__body a{display:inline-flex;align-items:center;gap:.28rem;color:var(--color-brand-strong);font-size:var(--fs-meta);font-weight:750}.aiugc-case--empty{display:grid;padding:1rem;gap:.35rem}.aiugc-case--empty p{font-size:var(--fs-body-sm);color:var(--color-text-muted)}
.aiugc-faq-custom{padding-top:.95rem}.aiugc-faq-custom__grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(19rem,.7fr);gap:1.25rem;align-items:start}.aiugc-custom{display:grid;grid-template-columns:auto 1fr;gap:.8rem;padding:1rem;box-shadow:none;background:#fbfcfd}.aiugc-custom__icon{display:grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%;background:#fff1f2;color:var(--color-brand-strong)}.aiugc-custom>div{display:grid;gap:.42rem}.aiugc-custom h2{font-size:1.2rem;line-height:1.16}.aiugc-custom p{font-size:var(--fs-body-sm);line-height:1.45;color:var(--color-text-muted)}.aiugc-custom .button{justify-self:start;margin-top:.08rem}.aiugc-final-cta{padding-block:.1rem 1rem}
