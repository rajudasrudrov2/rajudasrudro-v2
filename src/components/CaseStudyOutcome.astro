---
import Icon from './Icon.astro';
import type { CaseStudyOutcome } from '@/types/content';
const { items = [], developmentPreview = false } = Astro.props as { items?: CaseStudyOutcome[]; developmentPreview?: boolean };
---
{items.length > 0 && (
  <section class="case-outcome" aria-labelledby="case-outcome-title">
    <div class="container">
      <div class="case-section-heading">
        <h2 id="case-outcome-title">Project Outcome</h2>
        <p>{developmentPreview ? 'This development preview validates page architecture only; no client-performance result is asserted.' : 'Verified project outcomes from the authoritative project record.'}</p>
      </div>
      <div class="case-outcome__grid">
        {items.map((item) => (
          <div class="case-outcome__item">
            <span class="case-outcome__icon" aria-hidden="true"><Icon name="check" size={13} /></span>
            <span>
              {item.value && <strong>{item.value}</strong>}
              {item.label}
              {item.context && <small>{item.context}</small>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
.case-outcome{padding-block:.95rem;border-top:1px solid var(--color-border)}
.case-section-heading{display:grid;gap:.15rem;margin-bottom:.5rem}.case-section-heading h2{font-size:var(--fs-h2)}.case-section-heading p{font-size:var(--fs-body-sm);color:var(--color-text-muted)}
.case-outcome__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--color-border);border-radius:var(--radius-md);overflow:hidden}
.case-outcome__item{display:flex;align-items:flex-start;gap:.45rem;padding:.62rem .72rem;border-right:1px solid var(--color-border);font-size:var(--fs-meta);line-height:1.3;color:#475569}.case-outcome__item:last-child{border-right:0}.case-outcome__icon{flex:0 0 auto;width:1.15rem;height:1.15rem;display:grid;place-items:center;border-radius:50%;background:var(--color-brand-strong);color:#fff}.case-outcome__item strong{display:block;color:var(--color-text);font-size:var(--fs-body-sm)}.case-outcome__item small{display:block;color:var(--color-text-muted);margin-top:.08rem}
@media(max-width:47.99rem){.case-outcome{padding-block:.8rem}.case-section-heading h2{font-size:1.45rem}.case-section-heading p{font-size:var(--fs-body-sm)}.case-outcome__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.case-outcome__item{min-height:3.4rem;border-bottom:1px solid var(--color-border);font-size:var(--fs-caption);padding:.55rem}.case-outcome__item:nth-child(2n){border-right:0}.case-outcome__item:nth-last-child(-n+2){border-bottom:0}}
</style>
