---
const { item } = Astro.props;
---
{!item?.hidden && (
<article class="review-preview surface" data-development-placeholder>
  <span class="review-preview__label">Review migration pending</span>
  <h3>{item.title}</h3>
  <p>{item.text}</p>
  <div class="review-preview__foot"><span class="review-preview__avatar" aria-hidden="true">✓</span><span><strong>Verified source required</strong><small>Fiverr migration</small></span></div>
</article>
)}
<style>
.review-preview{display:grid;gap:.48rem;padding:.9rem;min-width:0}.review-preview__label{color:var(--color-brand-strong);font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.05em;text-transform:uppercase}.review-preview h3{font-size:var(--fs-card-title);line-height:1.18}.review-preview p{font-size:var(--fs-body-sm);color:var(--color-text-muted);line-height:1.42}.review-preview__foot{display:flex;align-items:center;gap:.5rem;margin-top:.1rem}.review-preview__avatar{width:1.65rem;height:1.65rem;display:grid;place-items:center;border-radius:50%;background:#ecfdf5;color:#059669;font-size:.8rem;font-weight:800}.review-preview__foot>span:last-child{display:grid;line-height:1.2}.review-preview__foot strong{font-size:var(--fs-meta)}.review-preview__foot small{font-size:var(--fs-caption);color:var(--color-text-muted)}
</style>
