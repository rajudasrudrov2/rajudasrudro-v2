---
import Icon from './Icon.astro';
const { service, compact = false } = Astro.props;
---
<article class:list={["service-card surface", {compact, flagship: service.flagship}]}>
  <div class="service-card__media">
    {service.media ? (
      <img
        src={service.media.src}
        alt={service.media.alt}
        width={service.media.width}
        height={service.media.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="service-card__fallback" aria-hidden="true"><Icon name="spark" size={30} /></div>
    )}
    {service.flagship && <span class="service-card__flagship">Flagship</span>}
    <span class="service-card__preview">Development preview</span>
  </div>
  <div class="service-card__body">
    <h3>{service.title}</h3>
    <p>{service.short}</p>
    {!compact && <ul>{service.bullets.map((item:string) => <li><Icon name="check" size={14} /> <span>{item}</span></li>)}</ul>}
    <a class="service-card__action" href={service.href} aria-label={`${service.ctaLabel}: ${service.title}`}>
      {service.ctaLabel} <Icon name="arrow" size={15} />
    </a>
  </div>
</article>
<style>
.service-card{overflow:hidden;box-shadow:none}.service-card.flagship{border-color:#f3a38f}.service-card__media{position:relative;aspect-ratio:16/9;overflow:hidden;background:#eef2f7}.service-card__media img{width:100%;height:100%;object-fit:cover}.service-card__fallback{width:100%;height:100%;display:grid;place-items:center;color:#64748b;background:#eef2f7}.service-card__flagship,.service-card__preview{position:absolute;top:.55rem;padding:.28rem .5rem;border-radius:.35rem;font-size:var(--fs-caption);font-weight:750;line-height:1.15}.service-card__flagship{left:.55rem;background:var(--color-brand-strong);color:#fff}.service-card__preview{right:.55rem;background:rgba(255,255,255,.92);color:#475569;border:1px solid rgba(226,232,240,.9)}.service-card__body{display:grid;gap:.62rem;padding:1rem}.service-card h3{font-size:var(--fs-card-title);line-height:1.2}.service-card p{font-size:var(--fs-body-sm);line-height:var(--lh-body-tight);color:var(--color-text-muted)}.service-card ul{display:grid;gap:.4rem;list-style:none}.service-card li{display:flex;align-items:flex-start;gap:.42rem;font-size:var(--fs-meta);line-height:1.35;color:#475569}.service-card li :global(svg){flex:0 0 auto;margin-top:.08rem;color:var(--color-brand-strong)}.service-card__action{display:inline-flex;align-items:center;min-height:2.5rem;gap:.3rem;justify-self:start;margin-top:.1rem;color:var(--color-brand-strong);font-size:var(--fs-meta);font-weight:750}.service-card__action:hover{text-decoration:underline;text-underline-offset:.18em}.service-card.compact{display:grid;grid-template-columns:8rem 1fr}.service-card.compact .service-card__media{aspect-ratio:auto;min-height:7rem}
@media(max-width:47.99rem){.service-card:not(.compact){display:grid;grid-template-columns:7.4rem minmax(0,1fr);min-height:8.1rem}.service-card:not(.compact) .service-card__media{aspect-ratio:auto;height:100%;min-height:8.1rem}.service-card__body{align-content:center;padding:.78rem .82rem;gap:.35rem}.service-card h3{font-size:1rem}.service-card p{font-size:var(--fs-meta);line-height:1.38}.service-card ul{display:none}.service-card__flagship,.service-card__preview{font-size:var(--fs-caption);padding:.2rem .32rem}.service-card__preview{display:none}.service-card__action{min-height:2.75rem;font-size:var(--fs-meta)}}
</style>
