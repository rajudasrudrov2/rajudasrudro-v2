---
const { poster, alt = '', duration, ratio = '16/9', unavailable = false, caption } = Astro.props;
---
<figure class="video" style={`--ratio:${ratio}`} data-video-preview>
  <div class="video__frame">
    {poster ? <img src={poster} alt={alt} width="960" height="540" loading="lazy" decoding="async" /> : <div class="video__fallback" aria-hidden="true"></div>}
    {unavailable ? <div class="video__state">Video unavailable</div> : <button class="video__play" type="button" aria-label="Play video preview"><span aria-hidden="true">▶</span></button>}
    {duration && <span class="video__duration">{duration}</span>}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>.video{margin:0}.video__frame{position:relative;aspect-ratio:var(--ratio);overflow:hidden;border-radius:var(--radius-lg);background:#111827}.video img,.video__fallback{width:100%;height:100%;object-fit:cover}.video__fallback{background:linear-gradient(135deg,#dbe3ea,#f8fafc 50%,#cbd5e1)}.video__play{position:absolute;left:50%;top:50%;width:3.1rem;height:3.1rem;transform:translate(-50%,-50%);display:grid;place-items:center;border-radius:50%;border:2px solid rgba(255,255,255,.9);background:rgba(15,23,42,.62);color:#fff;cursor:pointer;transition:transform var(--transition),background var(--transition)}.video__play:hover{transform:translate(-50%,-50%) scale(1.06);background:rgba(15,23,42,.8)}.video__duration{position:absolute;right:.5rem;bottom:.5rem;padding:.15rem .35rem;border-radius:.25rem;background:rgba(0,0,0,.7);color:white;font-size:.65rem}.video__state{position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:.8rem;background:rgba(2,6,23,.7)}.video figcaption{font-size:.72rem;color:var(--color-text-muted);margin-top:.35rem}</style>
