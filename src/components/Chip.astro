---
const { active = false, href, tone = 'neutral' } = Astro.props;
const cls=['chip',active?'chip--active':'',`chip--${tone}`].join(' ');
---
{href ? <a class={cls} href={href}><slot /></a> : <span class={cls}><slot /></span>}
<style>.chip{display:inline-flex;align-items:center;min-height:1.75rem;padding:.35rem .7rem;border:1px solid var(--color-border);border-radius:999px;background:#fff;font-size:.72rem;color:#475569}.chip--active{background:var(--color-text);border-color:var(--color-text);color:#fff}.chip--brand{background:#fff1f2;color:#ef4444;border-color:transparent}.chip--blue{background:#eff6ff;color:#2563eb;border-color:transparent}</style>
