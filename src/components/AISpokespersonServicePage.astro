---
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import CTA from './CTA.astro';
import FAQ from './FAQ.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import TrustMetric from './TrustMetric.astro';
import { homeTrustMetrics } from '@/data/home';
import { featuredWorkProject, workProjects } from '@/data/work';
import type { ServiceDefinition } from '@/data/services';

const { service } = Astro.props as { service: ServiceDefinition };
const detail = service.detail;
if (!detail || detail.kind !== 'ai-spokesperson') {
  throw new Error('AISpokespersonServicePage requires the AI Spokesperson service detail record.');
}

const allWork = [featuredWorkProject, ...workProjects];
const caseStudyProject = allWork.find(
  (project) =>
    project.categories.includes('AI Spokesperson') &&
    project.caseStudyStatus === 'available' &&
    Boolean(project.detailHref),
);
const selectedSpokespersonWork = allWork
  .filter(
    (project) =>
      project.categories.includes('AI Spokesperson') &&
      project.id !== caseStudyProject?.id,
  )
  .slice(0, 6);
---
<div class="spokesperson-page">
  <section class="spokesperson-top" aria-labelledby="spokesperson-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: service.title, href: service.href }]} />

      <div class="spokesperson-hero">
        <div class="spokesperson-hero__copy">
          <p class="eyebrow">{detail.eyebrow}</p>
          <h1 id="spokesperson-title">{detail.heroTitle}</h1>
          <p class="spokesperson-hero__lede">{detail.heroDescription}</p>
          <div class="spokesperson-hero__actions">
            <Button href="/contact/">Start a Project <Icon name="arrow" size={16} /></Button>
            <Button href="/work/" variant="secondary">View Spokesperson Work</Button>
          </div>
        </div>

        <div class="spokesperson-hero-media" role="group" aria-label="Development preview media illustrating AI spokesperson directions">
          <span class="spokesperson-preview-label">Development preview media</span>
          {detail.heroMedia.map((media, index) => (
            <figure class:list={['spokesperson-hero-media__item', 'surface', { 'spokesperson-hero-media__item--main': index === 0 }]}>
              <img
                src={media.src}
                alt={media.alt}
                width={media.width}
                height={media.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                decoding="async"
              />
              <span class="spokesperson-media-state">Preview</span>
            </figure>
          ))}
        </div>
      </div>

      <div class="spokesperson-trust surface" aria-label="Accepted trust indicators">
        {homeTrustMetrics.map((metric) => <TrustMetric {...metric} />)}
      </div>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-intro-section" aria-label="AI spokesperson explanation and common use cases">
    <div class="container spokesperson-intro-grid">
      <div class="spokesperson-copy-block">
        <h2>{detail.explanation.title}</h2>
        <p>{detail.explanation.description}</p>
        <a class="spokesperson-text-link" href="/contact/">Discuss your message <Icon name="arrow" size={15} /></a>
      </div>

      <div>
        <div class="spokesperson-section-heading spokesperson-section-heading--compact">
          <h2>Where It Works Best</h2>
          <p>Presenter-led communication formats that fit a clear script, message or explanation.</p>
        </div>
        <div class="spokesperson-use-cases" role="list">
          {detail.useCases.map((item) => (
            <article class="spokesperson-use-case surface" role="listitem">
              <span aria-hidden="true"><Icon name={item.icon} size={23} /></span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-presenters-section" aria-labelledby="spokesperson-presenters-title">
    <div class="container">
      <div class="spokesperson-section-heading spokesperson-section-heading--with-link">
        <div>
          <h2 id="spokesperson-presenters-title">Presenter Options</h2>
          <p>Choose a presenter direction, tone and environment that fit the approved message and audience.</p>
        </div>
        <a href="/contact/">Discuss a presenter style <Icon name="arrow" size={15} /></a>
      </div>
      <div class="spokesperson-presenter-grid" role="list">
        {detail.presenterOptions.map((item) => (
          <article class="spokesperson-presenter-card surface" role="listitem">
            <div class="spokesperson-presenter-card__media">
              <img src={item.media.src} alt={item.media.alt} width={item.media.width} height={item.media.height} loading="lazy" decoding="async" />
              <span>Preview</span>
            </div>
            <div><h3>{item.title}</h3><p>{item.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-included-section" aria-labelledby="spokesperson-included-title">
    <div class="container">
      <div class="spokesperson-section-heading spokesperson-section-heading--compact">
        <h2 id="spokesperson-included-title">What You Get</h2>
        <p>A complete spokesperson-video production workflow from the approved message through final delivery.</p>
      </div>
      <div class="spokesperson-phases" role="list">
        {detail.productionPhases.map((phase) => (
          <article class="spokesperson-phase surface" role="listitem">
            <div class="spokesperson-phase__head">
              <span aria-hidden="true"><Icon name={phase.icon} size={24} /></span>
              <div><h3>{phase.title}</h3><p>{phase.description}</p></div>
            </div>
            <ul>
              {phase.items.map((item) => <li><Icon name="check" size={14} /><span>{item}</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-work-section" aria-labelledby="spokesperson-work-title">
    <div class="container">
      <div class="spokesperson-section-heading spokesperson-section-heading--with-link">
        <div>
          <h2 id="spokesperson-work-title">Selected Spokesperson Work</h2>
          <p>Existing structured Work records tagged for AI Spokesperson. Development-preview status remains explicit.</p>
        </div>
        <a href="/work/">View All Work <Icon name="arrow" size={15} /></a>
      </div>
      {selectedSpokespersonWork.length > 0 ? (
        <div class="spokesperson-work-grid">
          {selectedSpokespersonWork.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <div class="spokesperson-honest-state surface">
          <h3>Spokesperson work is pending migration</h3>
          <p>Verified production project records will appear here after portfolio migration. No fake work record is created.</p>
        </div>
      )}
    </div>
  </section>

  <section class="spokesperson-section spokesperson-language-section" aria-label="Multilingual capability and production approach comparison">
    <div class="container spokesperson-language-grid">
      <article class="spokesperson-language-card surface">
        <div class="spokesperson-section-heading spokesperson-section-heading--compact">
          <h2>{detail.multilingual.title}</h2>
          <p>{detail.multilingual.description}</p>
        </div>
        <div class="spokesperson-language-visual" aria-hidden="true">
          <img src="/images/work/spokesperson-preview.svg" alt="" width="800" height="450" loading="lazy" decoding="async" />
          <span>Language versions confirmed per project</span>
        </div>
        <ul class="spokesperson-check-list">
          {detail.multilingual.capabilities.map((item) => <li><Icon name="check" size={15} /><span>{item}</span></li>)}
        </ul>
      </article>

      <article class="spokesperson-comparison surface">
        <div class="spokesperson-section-heading spokesperson-section-heading--compact">
          <h2>AI Spokesperson vs Traditional Filming</h2>
          <p>Different production approaches with different operational trade-offs.</p>
        </div>
        <div class="spokesperson-comparison-grid">
          <div>
            <h3>AI Spokesperson Videos</h3>
            <ul>{detail.comparison.spokesperson.map((item) => <li><Icon name="check" size={14} /><span>{item}</span></li>)}</ul>
          </div>
          <div>
            <h3>Traditional Filming</h3>
            <ul>{detail.comparison.traditional.map((item) => <li><span class="spokesperson-comparison-dot" aria-hidden="true">•</span><span>{item}</span></li>)}</ul>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-process-section" aria-labelledby="spokesperson-process-title">
    <div class="container">
      <div class="spokesperson-section-heading spokesperson-section-heading--compact">
        <h2 id="spokesperson-process-title">A Simple Production Process</h2>
        <p>{detail.process.length} clear stages from message planning to final presenter-led video delivery.</p>
      </div>
      <div class="spokesperson-process-grid">
        {detail.process.map((step) => (
          <article class="spokesperson-process-step surface">
            <strong>{step.number}</strong>
            <div><h3>{step.title}</h3><p>{step.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-proof-section" aria-label="Why Raju, review proof state and case study state">
    <div class="container spokesperson-proof-grid">
      <div>
        <div class="spokesperson-section-heading spokesperson-section-heading--compact">
          <h2>Why Work With Raju?</h2>
          <p>Presenter-led production qualities grounded in the accepted service positioning.</p>
        </div>
        <ul class="spokesperson-why-list">
          {detail.whyRaju.map((item) => (
            <li><span aria-hidden="true"><Icon name="check" size={15} /></span><div><strong>{item.title}</strong><small>{item.description}</small></div></li>
          ))}
        </ul>
      </div>

      <article class="spokesperson-proof-state surface">
        <span class="spokesperson-proof-state__icon" aria-hidden="true"><Icon name="star" size={24} /></span>
        <div>
          <h2>Verified Review State</h2>
          <p>No spokesperson-specific verified review is currently mapped in the accepted source. General public reviews remain available without being relabeled as spokesperson proof.</p>
          <a href="/reviews/">View Reviews <Icon name="arrow" size={14} /></a>
        </div>
      </article>

      <article class="spokesperson-proof-state surface">
        <span class="spokesperson-proof-state__icon" aria-hidden="true"><Icon name="briefcase" size={24} /></span>
        <div>
          <h2>Case Study State</h2>
          {caseStudyProject ? (
            <>
              <p>A relevant Case Study record is available in the existing Work registry.</p>
              <a href={caseStudyProject.detailHref!}>View Case Study <Icon name="arrow" size={14} /></a>
            </>
          ) : (
            <p>No AI Spokesperson Case Study is currently detail-eligible. No fake route is exposed.</p>
          )}
        </div>
      </article>
    </div>
  </section>

  <section class="spokesperson-section spokesperson-faq-section" aria-labelledby="spokesperson-faq-title">
    <div class="container spokesperson-faq-layout">
      <div>
        <div class="spokesperson-section-heading spokesperson-section-heading--compact">
          <p class="eyebrow">Common Questions</p>
          <h2 id="spokesperson-faq-title">AI Spokesperson Video FAQs</h2>
          <p>Service-specific answers without unsupported language, likeness, delivery or performance guarantees.</p>
        </div>
        <FAQ items={detail.faqs} />
      </div>

      <aside class="spokesperson-custom surface">
        <span class="spokesperson-custom__icon" aria-hidden="true"><Icon name="spark" size={25} /></span>
        <div>
          <h2>{detail.customRequirement.title}</h2>
          <p>{detail.customRequirement.description}</p>
          <Button href="/contact/" variant="secondary">Discuss Your Project <Icon name="arrow" size={15} /></Button>
        </div>
      </aside>
    </div>
  </section>

  <div class="container spokesperson-final-cta">
    <CTA
      title="Ready to create a professional spokesperson video?"
      description="Share the script, audience and presenter direction and I’ll review the most suitable production approach."
      primaryHref="/contact/"
      primaryLabel="Start a Project"
      secondaryHref="/work/"
      secondaryLabel="View More Work"
    />
  </div>
</div>

<style>
.spokesperson-page{background:#fff}.spokesperson-top{padding-block:.85rem 1rem;border-bottom:1px solid var(--color-border)}.spokesperson-top :global(.breadcrumbs){margin-bottom:.75rem}.spokesperson-hero{display:grid;grid-template-columns:minmax(0,.88fr) minmax(31rem,1.12fr);gap:2rem;align-items:center}.spokesperson-hero__copy{display:grid;gap:.72rem;align-content:center}.spokesperson-hero__copy .eyebrow{color:var(--color-brand-strong)}.spokesperson-hero__copy h1{font-size:var(--fs-h1);max-width:14ch}.spokesperson-hero__lede{max-width:43rem;color:#536179;font-size:var(--fs-body-lg);line-height:1.5}.spokesperson-hero__actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:.1rem}.spokesperson-hero-media{position:relative;display:grid;grid-template-columns:1.6fr .9fr;grid-template-rows:1fr 1fr;gap:.5rem;min-width:0}.spokesperson-hero-media__item{position:relative;overflow:hidden;margin:0;aspect-ratio:16/9;box-shadow:none}.spokesperson-hero-media__item--main{grid-row:1/3;aspect-ratio:1.22}.spokesperson-hero-media img{width:100%;height:100%;object-fit:cover}.spokesperson-preview-label{position:absolute;z-index:2;right:.55rem;top:.55rem;padding:.25rem .4rem;border-radius:.28rem;background:rgba(255,255,255,.92);border:1px solid rgba(226,232,240,.95);color:#475569;font-size:var(--fs-caption);font-weight:750;text-transform:uppercase;letter-spacing:.035em}.spokesperson-media-state{position:absolute;right:.45rem;bottom:.45rem;padding:.2rem .35rem;border-radius:.24rem;background:rgba(15,23,42,.72);color:#fff;font-size:var(--fs-caption);font-weight:750;text-transform:uppercase;letter-spacing:.03em}.spokesperson-trust{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:.9rem;box-shadow:none;background:#fbfcfd}.spokesperson-trust> :global(.trust){border-right:1px solid var(--color-border)}.spokesperson-trust> :global(.trust:last-child){border-right:0}
.spokesperson-section{padding-block:1.2rem}.spokesperson-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:.7rem}.spokesperson-section-heading>div{display:grid;gap:.18rem}.spokesperson-section-heading h2{font-size:clamp(1.55rem,2vw,1.95rem)}.spokesperson-section-heading p{color:var(--color-text-muted);font-size:var(--fs-body-sm);line-height:1.45}.spokesperson-section-heading--compact{display:grid;justify-content:start;align-items:start;gap:.12rem}.spokesperson-section-heading--with-link>a,.spokesperson-text-link{display:inline-flex;align-items:center;gap:.3rem;color:#2563eb;font-size:var(--fs-meta);font-weight:750}.spokesperson-copy-block{display:grid;align-content:start;gap:.45rem}.spokesperson-copy-block h2{font-size:clamp(1.65rem,2.25vw,2.05rem)}.spokesperson-copy-block>p{color:#536179;line-height:1.55;font-size:var(--fs-body)}
.spokesperson-intro-section{background:#fff}.spokesperson-intro-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(34rem,1.18fr);gap:2rem;align-items:start}.spokesperson-use-cases{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.45rem}.spokesperson-use-case{min-width:0;display:grid;justify-items:center;text-align:center;gap:.28rem;padding:.8rem .45rem;box-shadow:none;background:#fbfcfd}.spokesperson-use-case>span{display:grid;place-items:center;color:#17365c}.spokesperson-use-case h3{overflow-wrap:anywhere;font-size:.98rem;line-height:1.18}.spokesperson-use-case p{display:none;color:var(--color-text-muted);font-size:var(--fs-caption);line-height:1.35}
.spokesperson-presenters-section{border-block:1px solid #f0f2f4;background:#fbfcfd}.spokesperson-presenter-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.52rem}.spokesperson-presenter-card{min-width:0;overflow:hidden;box-shadow:none}.spokesperson-presenter-card__media{position:relative;aspect-ratio:16/9;background:#eef2f7;overflow:hidden}.spokesperson-presenter-card img{width:100%;height:100%;object-fit:cover}.spokesperson-presenter-card__media span{position:absolute;right:.35rem;bottom:.35rem;padding:.18rem .3rem;background:rgba(15,23,42,.72);color:#fff;border-radius:.22rem;font-size:var(--fs-caption);font-weight:700;text-transform:uppercase}.spokesperson-presenter-card>div:last-child{display:grid;gap:.12rem;padding:.55rem}.spokesperson-presenter-card h3{overflow-wrap:anywhere;font-size:1rem;line-height:1.2}.spokesperson-presenter-card p{font-size:var(--fs-body-sm);line-height:1.38;color:var(--color-text-muted)}
.spokesperson-included-section{border-bottom:1px solid #f0f2f4}.spokesperson-phases{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem}.spokesperson-phase{padding:.8rem;box-shadow:none;background:#fbfcfd}.spokesperson-phase__head{display:grid;grid-template-columns:auto 1fr;gap:.55rem;align-items:start}.spokesperson-phase__head>span{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:50%;background:#fff2f1;color:var(--color-brand-strong)}.spokesperson-phase:nth-child(2) .spokesperson-phase__head>span,.spokesperson-phase:nth-child(4) .spokesperson-phase__head>span{background:#eff6ff;color:#2563eb}.spokesperson-phase h3{font-size:1.05rem}.spokesperson-phase__head p{font-size:var(--fs-caption);color:var(--color-text-muted)}.spokesperson-phase ul{display:grid;gap:.27rem;list-style:none;margin-top:.55rem}.spokesperson-phase li{display:flex;gap:.35rem;align-items:flex-start;font-size:var(--fs-body-sm);line-height:1.38;color:#475569}.spokesperson-phase li :global(svg){flex:0 0 auto;margin-top:.15rem;color:var(--color-brand-strong)}
.spokesperson-work-section{background:#fff}.spokesperson-work-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.spokesperson-work-grid> :global(.project-card){height:100%}.spokesperson-honest-state{display:grid;gap:.35rem;padding:1rem;box-shadow:none}.spokesperson-honest-state h3{font-size:1.05rem}.spokesperson-honest-state p{font-size:var(--fs-body-sm);line-height:1.43;color:var(--color-text-muted)}
.spokesperson-language-section{border-block:1px solid #f0f2f4;background:#fbfcfd}.spokesperson-language-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.spokesperson-language-card,.spokesperson-comparison{padding:1rem;box-shadow:none;background:#fff}.spokesperson-language-visual{position:relative;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-md);margin-bottom:.7rem;aspect-ratio:2.35}.spokesperson-language-visual img{width:100%;height:100%;object-fit:cover}.spokesperson-language-visual span{position:absolute;left:.55rem;bottom:.55rem;padding:.28rem .45rem;border-radius:.28rem;background:rgba(255,255,255,.92);color:#334155;font-size:var(--fs-caption);font-weight:750}.spokesperson-check-list,.spokesperson-comparison ul{display:grid;gap:.38rem;list-style:none}.spokesperson-check-list li,.spokesperson-comparison li{display:flex;gap:.38rem;align-items:flex-start;font-size:var(--fs-body-sm);line-height:1.42;color:#475569}.spokesperson-check-list li :global(svg),.spokesperson-comparison>div ul li :global(svg){flex:0 0 auto;margin-top:.16rem;color:var(--color-brand-strong)}.spokesperson-comparison-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.spokesperson-comparison-grid>div{padding:.75rem;border:1px solid var(--color-border);border-radius:var(--radius-md);background:#fbfcfd}.spokesperson-comparison-grid h3{font-size:1.05rem;margin-bottom:.5rem}.spokesperson-comparison-dot{display:grid;place-items:center;width:1rem;height:1rem;flex:0 0 1rem;margin-top:.14rem;border-radius:50%;background:#e9eef5;color:#475569;font-size:.9rem;line-height:1}
.spokesperson-process-section{padding-block:1.1rem}.spokesperson-process-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));align-items:stretch;gap:.55rem}.spokesperson-process-step{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.55rem;align-items:start;min-width:0;padding:.75rem;box-shadow:none}.spokesperson-process-step>strong{font-size:1.55rem;line-height:1;color:var(--color-brand-strong)}.spokesperson-process-step>div{min-width:0}.spokesperson-process-step h3{font-size:1rem;overflow-wrap:anywhere}.spokesperson-process-step p{font-size:var(--fs-body-sm);line-height:1.38;color:var(--color-text-muted);overflow-wrap:anywhere}
.spokesperson-proof-section{padding-top:.35rem}.spokesperson-proof-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.78fr) minmax(18rem,.78fr);gap:1rem;align-items:start}.spokesperson-why-list{display:grid;gap:.35rem;list-style:none}.spokesperson-why-list li{display:flex;gap:.45rem;align-items:flex-start}.spokesperson-why-list li>span{display:grid;place-items:center;width:1.2rem;height:1.2rem;flex:0 0 1.2rem;margin-top:.08rem;border-radius:50%;background:#fff0ee;color:var(--color-brand-strong)}.spokesperson-why-list li>div{display:grid;gap:.02rem}.spokesperson-why-list strong{font-size:var(--fs-meta)}.spokesperson-why-list small{font-size:var(--fs-caption);line-height:1.35;color:var(--color-text-muted)}.spokesperson-proof-state{display:grid;grid-template-columns:auto 1fr;gap:.7rem;padding:1rem;box-shadow:none;background:#fbfcfd}.spokesperson-proof-state__icon{display:grid;place-items:center;width:2.6rem;height:2.6rem;border-radius:50%;background:#fff1f2;color:var(--color-brand-strong)}.spokesperson-proof-state>div{display:grid;gap:.35rem}.spokesperson-proof-state h2{font-size:1.15rem}.spokesperson-proof-state p{font-size:var(--fs-body-sm);line-height:1.44;color:var(--color-text-muted)}.spokesperson-proof-state a{display:inline-flex;align-items:center;gap:.25rem;justify-self:start;color:var(--color-brand-strong);font-size:var(--fs-meta);font-weight:750}
.spokesperson-faq-section{background:#fbfcfd;border-top:1px solid #f0f2f4}.spokesperson-faq-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(18rem,.55fr);gap:2rem;align-items:start}.spokesperson-custom{display:grid;grid-template-columns:auto 1fr;gap:.75rem;padding:1rem;box-shadow:none;background:#fff}.spokesperson-custom__icon{display:grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%;background:#fff1f2;color:var(--color-brand-strong)}.spokesperson-custom>div{display:grid;gap:.45rem}.spokesperson-custom h2{font-size:1.2rem}.spokesperson-custom p{font-size:var(--fs-body-sm);line-height:1.44;color:var(--color-text-muted)}.spokesperson-custom .button{justify-self:start}.spokesperson-final-cta{padding-block:.75rem 1rem}
