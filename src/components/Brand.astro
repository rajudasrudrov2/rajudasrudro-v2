---
import { site, siteRoutes } from '@/data/site';
const { compact = false } = Astro.props;
---
<a class:list={["brand", { "brand--compact": compact }]} href={siteRoutes.home} aria-label={`${site.name} — Home`}>
  <img src="/images/raju-das-rudro.webp" width="40" height="40" alt="" loading="eager" decoding="async" />
  <span class="brand__copy">
    <strong>{site.name}</strong>
    {!compact && <small>{site.shortRole}</small>}
  </span>
</a>
<style>
.brand{display:inline-flex;align-items:center;gap:.62rem;min-width:0}.brand img{width:2.35rem;height:2.35rem;border-radius:50%;object-fit:cover;object-position:center 24%;border:1px solid var(--color-border);background:#f3f4f6}.brand__copy{display:grid;line-height:1.08;min-width:0}.brand strong{font-family:var(--font-body);font-size:var(--fs-card-title);font-weight:800;letter-spacing:-.025em;white-space:nowrap}.brand small{font-size:var(--fs-caption);color:var(--color-text-muted);white-space:nowrap;margin-top:.16rem;font-weight:500}.brand--compact .brand__copy{display:none}@media(max-width:25rem){.brand small{display:none}.brand img{width:2.2rem;height:2.2rem}}
</style>
