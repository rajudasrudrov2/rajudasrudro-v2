---
const gaMeasurementId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim();
---

<section
  id="analytics-consent"
  class="analytics-consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <div class="analytics-consent__inner">
    <div class="analytics-consent__copy">
      <p class="analytics-consent__eyebrow">Privacy choice</p>
      <h2 id="analytics-consent-title">Optional analytics</h2>
      <p id="analytics-consent-description">
        We use Google Analytics only if you accept, to understand how visitors use this website and improve the experience.
        Advertising and remarketing remain disabled.
      </p>
      <a href="/privacy-policy/">Read the Privacy Policy</a>
    </div>
    <div class="analytics-consent__actions">
      <button type="button" class="analytics-consent__button analytics-consent__button--secondary" data-consent-action="reject">
        Reject
      </button>
      <button type="button" class="analytics-consent__button analytics-consent__button--primary" data-consent-action="accept">
        Accept analytics
      </button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ gaMeasurementId }}>
  (() => {
    const CONSENT_KEY = 'rdr_analytics_consent_v1';
    const banner = document.getElementById('analytics-consent');
    const acceptButton = banner?.querySelector('[data-consent-action="accept"]');
    const rejectButton = banner?.querySelector('[data-consent-action="reject"]');
    const settingsButtons = document.querySelectorAll('[data-consent-settings]');

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () {
      window.dataLayer.push(arguments);
    };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });

    const hasValidMeasurementId = /^G-[A-Z0-9]+$/i.test(gaMeasurementId);
    let currentChoice = null;

    try {
      const storedChoice = window.localStorage.getItem(CONSENT_KEY);
      if (storedChoice === 'granted' || storedChoice === 'denied') {
        currentChoice = storedChoice;
      }
    } catch {
      currentChoice = null;
    }

    const persistChoice = (choice) => {
      currentChoice = choice;
      try {
        window.localStorage.setItem(CONSENT_KEY, choice);
      } catch {
        // The consent choice still applies for the current page if storage is unavailable.
      }
    };

    const hideBanner = () => {
      if (banner) banner.hidden = true;
    };

    const showBanner = () => {
      if (!banner) return;
      banner.hidden = false;
      const firstAction = banner.querySelector('[data-consent-action]');
      if (firstAction instanceof HTMLElement) {
        firstAction.focus({ preventScroll: true });
      }
    };

    const loadGoogleAnalytics = () => {
      if (!hasValidMeasurementId) return;

      if (document.querySelector('script[data-rdr-ga]')) return;

      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId);

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`;
      script.dataset.rdrGa = gaMeasurementId;
      document.head.appendChild(script);
    };

    const grantAnalytics = () => {
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      loadGoogleAnalytics();
    };

    const denyAnalytics = () => {
      window.gtag('consent', 'update', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    };

    if (currentChoice === 'granted') {
      grantAnalytics();
    } else if (currentChoice === 'denied') {
      denyAnalytics();
    } else {
      showBanner();
    }

    acceptButton?.addEventListener('click', () => {
      persistChoice('granted');
      grantAnalytics();
      hideBanner();
      window.dispatchEvent(new CustomEvent('rdr:analytics-consent', { detail: { analytics: 'granted' } }));
    });

    rejectButton?.addEventListener('click', () => {
      const wasGranted = currentChoice === 'granted';
      persistChoice('denied');
      denyAnalytics();
      hideBanner();
      window.dispatchEvent(new CustomEvent('rdr:analytics-consent', { detail: { analytics: 'denied' } }));

      // If Analytics was already loaded during this page view, reload so the next
      // page lifecycle starts with the Google tag fully blocked.
      if (wasGranted && hasValidMeasurementId) {
        window.location.reload();
      }
    });

    settingsButtons.forEach((button) => {
      button.addEventListener('click', showBanner);
    });

    window.rdrAnalyticsConsent = {
      open: showBanner,
      getChoice: () => currentChoice
    };
  })();
</script>

<style>
.analytics-consent[hidden]{display:none}
.analytics-consent{position:fixed;z-index:1000;right:var(--page-pad);bottom:var(--page-pad);left:var(--page-pad);margin-inline:auto;width:min(calc(100% - (var(--page-pad) * 2)),48rem);border:1px solid var(--color-border);border-radius:var(--radius-lg);background:#fff;box-shadow:0 24px 60px rgba(15,23,42,.18)}
.analytics-consent__inner{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-6);padding:var(--space-5)}
.analytics-consent__copy{display:grid;gap:.45rem;max-width:34rem}
.analytics-consent__eyebrow{color:var(--color-text-muted);font-size:var(--fs-eyebrow);font-weight:var(--weight-semibold);letter-spacing:.065em;text-transform:uppercase}
.analytics-consent h2{font-size:clamp(1.15rem,2vw,1.4rem)}
.analytics-consent p{color:var(--color-text-muted);font-size:var(--fs-meta);line-height:var(--lh-body-tight)}
.analytics-consent a{width:max-content;color:var(--color-text);font-size:var(--fs-caption);font-weight:var(--weight-semibold);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.analytics-consent__actions{display:flex;flex:0 0 auto;gap:.6rem}
.analytics-consent__button{min-height:2.65rem;border-radius:var(--radius-md);padding:.65rem .9rem;font-size:var(--fs-meta);font-weight:var(--weight-semibold);cursor:pointer}
.analytics-consent__button--secondary{border:1px solid var(--color-border);background:#fff;color:var(--color-text)}
.analytics-consent__button--primary{border:1px solid var(--color-text);background:var(--color-text);color:#fff}
.analytics-consent__button:hover{transform:translateY(-1px)}
@media(max-width:47.99rem){
  .analytics-consent{right:.75rem;bottom:.75rem;left:.75rem;width:auto}
  .analytics-consent__inner{display:grid;gap:var(--space-4);padding:var(--space-4)}
  .analytics-consent__actions{display:grid;grid-template-columns:1fr 1fr}
  .analytics-consent__button{width:100%}
}
@media(max-width:24rem){
  .analytics-consent__actions{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){
  .analytics-consent__button:hover{transform:none}
}
</style>
