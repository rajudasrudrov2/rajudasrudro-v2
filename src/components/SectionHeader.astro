---
const { eyebrow, title, description, linkHref, linkLabel = 'View all', id } = Astro.props;
---
<div class="section-header">
  <div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2 id={id}>{title}</h2>{description && <p>{description}</p>}</div>
  {linkHref && <a href={linkHref}>{linkLabel} <span aria-hidden="true">→</span></a>}
</div>
<style>
.section-header{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1rem}.section-header>div{display:grid;gap:.2rem}.section-header h2{font-size:var(--fs-h2);font-weight:750;line-height:1.04}.section-header p:not(.eyebrow){font-size:var(--fs-body-sm);color:var(--color-text-muted);line-height:1.4}.section-header>a{font-size:var(--fs-meta);color:#2563eb;font-weight:700;white-space:nowrap}.section-header>a:hover{text-decoration:underline;text-underline-offset:.18em}@media(max-width:47.99rem){.section-header{align-items:center;margin-bottom:.7rem}.section-header h2{font-size:var(--fs-h2)}.section-header p:not(.eyebrow){font-size:var(--fs-body-sm)}.section-header>a{font-size:var(--fs-meta)}}
</style>
