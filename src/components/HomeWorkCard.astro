---
import Icon from './Icon.astro';
const { item } = Astro.props;
const showDevelopmentBadge = item.developmentPreview !== false;
const mediaWidth = Number.isFinite(item.width) && item.width > 0 ? Math.round(item.width) : 800;
const mediaHeight = Number.isFinite(item.height) && item.height > 0 ? Math.round(item.height) : 450;
---
<article class="home-work-card surface" data-development-placeholder={showDevelopmentBadge ? '' : undefined}>
  <div class="home-work-card__media">
    {item.media ? <img src={item.media} width={mediaWidth} height={mediaHeight} alt={item.alt || ''} loading="lazy" decoding="async" /> : <div class="home-work-card__fallback" aria-hidden="true"></div>}
    {showDevelopmentBadge && <span class="home-work-card__badge">Development preview</span>}
  </div>
  <div class="home-work-card__body">
    <h3>{item.title}</h3>
    <p>{item.context}</p>
    <a href={item.href}>View Work <Icon name="arrow" size={15} /></a>
  </div>
</article>
<style>
.home-work-card{overflow:hidden;min-width:0}.home-work-card__media{position:relative;aspect-ratio:16/9;overflow:hidden;background:#e2e8f0}.home-work-card__media img{width:100%;height:100%;object-fit:cover}.home-work-card__fallback{width:100%;height:100%;background:#eef2f7}.home-work-card__badge{position:absolute;left:.55rem;top:.55rem;padding:.24rem .42rem;border-radius:.28rem;background:rgba(15,23,42,.84);color:#fff;font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.03em;text-transform:uppercase}.home-work-card__body{display:grid;gap:.24rem;padding:.72rem .78rem .82rem}.home-work-card h3{font-size:var(--fs-card-title);line-height:1.18;letter-spacing:-.025em}.home-work-card p{font-size:var(--fs-meta);color:var(--color-text-muted)}.home-work-card a{display:inline-flex;align-items:center;gap:.25rem;margin-top:.15rem;color:var(--color-brand-strong);font-size:var(--fs-meta);font-weight:700;justify-self:start}.home-work-card a:hover{color:var(--color-brand-strong)}
@media(max-width:47.99rem){.home-work-card{min-width:calc(100vw - 4.1rem);scroll-snap-align:start}.home-work-card__body{padding:.66rem .72rem .76rem}}
</style>
