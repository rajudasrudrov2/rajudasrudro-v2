---
import Icon from './Icon.astro';
const { value, label, icon = 'star' } = Astro.props;
const namedIcons = new Set(['star','users','briefcase','globe','video','spark','monitor','arrow','check']);
const useNamedIcon = typeof icon === 'string' && namedIcons.has(icon);
---
<div class="trust">
  <span class="trust__icon" aria-hidden="true">{useNamedIcon ? <Icon name={icon} size={21} /> : icon}</span>
  <span><strong>{value}</strong><small>{label}</small></span>
</div>
<style>
.trust{display:flex;align-items:center;justify-content:center;gap:.62rem;padding:.72rem 1rem;min-width:0}.trust__icon{display:grid;place-items:center;color:#0f2743;font-size:1.05rem}.trust span:last-child{display:grid;line-height:1.1}.trust strong{font-family:var(--font-body);font-size:1.08rem;font-weight:800;letter-spacing:-.03em}.trust small{font-size:var(--fs-caption);color:var(--color-text-muted);margin-top:.14rem;white-space:nowrap}
@media(max-width:47.99rem){.trust{justify-content:flex-start;padding:.7rem .68rem}.trust__icon{font-size:.95rem}.trust strong{font-size:1rem}.trust small{font-size:var(--fs-caption)}}
</style>
