---
const { href, variant = 'primary', size = 'md', type = 'button', class: className = '', disabled = false } = Astro.props;
const cls = ['button', `button--${variant}`, `button--${size}`, className].filter(Boolean).join(' ');
---
{href ? (
  <a class={cls} href={href} aria-disabled={disabled ? 'true' : undefined} tabindex={disabled ? -1 : undefined}><slot /></a>
) : (
  <button class={cls} type={type} disabled={disabled}><slot /></button>
)}
<style>
.button{display:inline-flex;min-height:2.65rem;align-items:center;justify-content:center;gap:.45rem;border-radius:var(--radius-md);border:1px solid transparent;padding:.68rem 1.08rem;font-family:var(--font-body);font-weight:700;font-size:var(--fs-button);line-height:1;transition:background var(--transition),border-color var(--transition),color var(--transition),transform var(--transition);cursor:pointer}.button:hover{transform:translateY(-1px)}.button:active{transform:translateY(0)}.button--primary{background:var(--color-brand-strong);border-color:var(--color-brand-strong);color:#fff}.button--primary:hover{background:var(--color-brand-hover);border-color:var(--color-brand-hover)}.button--secondary{background:#fff;border-color:var(--color-brand);color:var(--color-text)}.button--secondary:hover{background:#fff7f7}.button--dark{background:transparent;color:#fff;border-color:rgba(255,255,255,.58)}.button--dark:hover{background:rgba(255,255,255,.08)}.button--ghost{background:transparent;border-color:var(--color-border);color:var(--color-text)}.button--sm{min-height:2.15rem;padding:.5rem .8rem;font-size:var(--fs-meta)}.button[disabled],.button[aria-disabled="true"]{opacity:.48;pointer-events:none;transform:none}@media(max-width:47.99rem){.button{min-height:2.75rem;font-size:var(--fs-button)}}
</style>
