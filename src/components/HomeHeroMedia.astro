---
---
<div class="hero-media" aria-label="Development media preview for Raju Das Rudro services">
  <div class="hero-media__main surface">
    <img src="/images/home/hero-ugc-preview.svg" width="720" height="1080" alt="Abstract development preview for AI UGC media" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-media__side">
    <div class="hero-media__portrait surface">
      <img src="/images/raju-das-rudro.webp" width="635" height="640" alt="Raju Das Rudro" loading="eager" decoding="async" />
      <span>AI creative<br/>for modern brands</span>
    </div>
    <div class="hero-media__product surface">
      <img src="/images/home/hero-product-preview.svg" width="720" height="440" alt="Abstract development preview for AI product visuals" loading="eager" decoding="async" />
    </div>
  </div>
</div>
<style>
.hero-media{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:.72rem;min-width:0}.hero-media__main,.hero-media__portrait,.hero-media__product{position:relative;overflow:hidden;background:var(--color-bg-soft);box-shadow:none}.hero-media__main{aspect-ratio:.72}.hero-media__main img,.hero-media__portrait img,.hero-media__product img{width:100%;height:100%;object-fit:cover}.hero-media__side{display:grid;grid-template-rows:.9fr 1.1fr;gap:.72rem;min-width:0}.hero-media__portrait{min-height:0}.hero-media__portrait img{filter:saturate(.93);object-position:center 28%}.hero-media__portrait::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,31,42,.72),transparent 60%)}.hero-media__portrait span{position:absolute;z-index:1;left:.85rem;top:.8rem;color:white;font-size:.88rem;line-height:1.13;font-weight:800;letter-spacing:-.02em;text-transform:uppercase}.hero-media__product{min-height:0}
@media(max-width:47.99rem){.hero-media{gap:.45rem;grid-template-columns:1.06fr .94fr}.hero-media__side{gap:.45rem}.hero-media__portrait span{left:.48rem;top:.5rem;font-size:.56rem}.hero-media__main,.hero-media__portrait,.hero-media__product{border-radius:.5rem}}
</style>
