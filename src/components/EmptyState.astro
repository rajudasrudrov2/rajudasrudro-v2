---
const { title = 'Nothing here yet.', description = 'Content will appear here when it is published.' } = Astro.props;
---
<div class="empty surface" role="status"><div aria-hidden="true">▢</div><strong>{title}</strong><p>{description}</p></div>
<style>.empty{display:grid;place-items:center;text-align:center;padding:2.5rem 1.5rem;gap:.4rem;color:var(--color-text-muted)}.empty>div{font-size:1.7rem}.empty strong{color:var(--color-text);font-family:var(--font-display)}.empty p{font-size:var(--fs-body-sm)}</style>
