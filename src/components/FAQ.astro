---
const { items = [] } = Astro.props;
---
<div class="faq">{items.map((item:any) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><div><p>{item.answer}</p></div></details>)}</div>
<style>.faq{display:grid;border-top:1px solid var(--color-border)}.faq details{border-bottom:1px solid var(--color-border)}.faq summary{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;cursor:pointer;font-weight:600;font-size:var(--fs-body);list-style:none}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:var(--color-brand)}.faq details[open] summary span{transform:rotate(45deg)}.faq details div{padding:0 0 1rem}.faq p{color:var(--color-text-muted);font-size:var(--fs-body-sm);max-width:var(--reading)}</style>
