---
import Brand from './Brand.astro';
import { site } from '@/data/site';
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand"><Brand /><p>Helping modern brands grow with focused AI creative, UGC and web experiences.</p></div>
    <nav aria-label="Footer quick links"><strong>Quick Links</strong><a href="/work/">Work</a><a href="/services/">Services</a><a href="/about/">About</a><a href="/insights/">Insights</a></nav>
    <nav aria-label="Footer services"><strong>Services</strong><a href="/services/ai-ugc-video-ads/">AI UGC &amp; Video Creative</a><a href="/services/ai-video-production/">AI Video Production</a><a href="/services/ai-spokesperson-videos/">AI Spokesperson Videos</a><a href="/services/web-design-development/">Web Design &amp; Development</a></nav>
    <div class="footer__contact"><strong>Connect</strong><a href={site.fiverr} rel="me external">Fiverr</a><a href={`mailto:${site.email}`}>{site.email}</a></div>
  </div>
  <div class="container footer__bottom"><span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><nav aria-label="Legal"><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></nav></div>
</footer>
<style>
.footer{border-top:1px solid var(--color-border);background:#fff}.footer__grid{display:grid;grid-template-columns:1.55fr .58fr 1fr 1.06fr;gap:1.7rem;padding-block:1.15rem}.footer__brand p{max-width:17rem;margin-top:.55rem;color:var(--color-text-muted);font-size:var(--fs-meta);line-height:var(--lh-body-tight)}.footer nav,.footer__contact{display:grid;align-content:start;gap:.28rem}.footer strong{font-size:var(--fs-meta)}.footer a,.footer__bottom{font-size:var(--fs-caption);color:var(--color-text-muted)}.footer a:hover{color:var(--color-brand)}.footer__bottom{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid var(--color-border);padding-block:.7rem}.footer__bottom nav{display:flex;gap:1.1rem}
@media(max-width:47.99rem){.footer__grid{grid-template-columns:1fr 1fr;gap:.85rem 1.1rem;padding-block:1rem}.footer__brand{grid-column:1/-1}.footer__contact{grid-column:1/-1}.footer__brand p{font-size:var(--fs-caption)}.footer a,.footer__bottom{font-size:var(--fs-caption)}.footer__bottom{align-items:center;flex-direction:column;text-align:center;padding-block:.65rem}.footer__bottom nav{display:flex;flex-wrap:wrap;justify-content:center}}
</style>
