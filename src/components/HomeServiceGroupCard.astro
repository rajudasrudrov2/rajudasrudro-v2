---
import Icon from './Icon.astro';
const { service, featured = false } = Astro.props;
---
<article class:list={["home-service surface", { featured }]}>
  <div class="home-service__icon"><Icon name={service.icon} size={25} /></div>
  <div class="home-service__copy">
    <h3>{service.title}</h3>
    <p>{service.description}</p>
    <ul>
      {service.links.map((link: {label:string;href:string}) => <li><a href={link.href}><span aria-hidden="true">●</span>{link.label}</a></li>)}
    </ul>
    <a class="home-service__action" href={service.primaryHref}>{service.primaryLabel} <Icon name="arrow" size={15} /></a>
  </div>
</article>
<style>
.home-service{display:grid;grid-template-columns:auto 1fr;gap:.9rem;padding:1.05rem 1rem;min-width:0}.home-service.featured{border-color:#f09a7f}.home-service__icon{width:2.15rem;height:2.15rem;border:2px solid currentColor;border-radius:.42rem;display:grid;place-items:center;color:var(--color-brand)}.home-service:nth-child(2) .home-service__icon{color:#2563eb;border-radius:50%}.home-service:nth-child(3) .home-service__icon{color:#0f9f8f}.home-service__copy{display:grid;gap:.46rem}.home-service h3{font-size:1.02rem;line-height:1.12}.home-service p{color:var(--color-text-muted);font-size:.75rem;line-height:1.42}.home-service ul{list-style:none;display:grid;gap:.28rem;margin-top:.15rem}.home-service li a{display:flex;align-items:center;gap:.45rem;color:#475569;font-size:.69rem}.home-service li span{color:var(--color-brand-strong);font-size:.48rem}.home-service__action{display:inline-flex;align-items:center;gap:.28rem;margin-top:.2rem;color:var(--color-brand-strong);font-size:.73rem;font-weight:700;justify-self:start}.home-service__action:hover{color:var(--color-brand-strong)}
@media(max-width:47.99rem){.home-service{padding:.78rem .8rem;gap:.72rem}.home-service__icon{width:2rem;height:2rem}.home-service p{font-size:.7rem}.home-service ul{display:none}.home-service__action{font-size:.69rem}}
</style>
