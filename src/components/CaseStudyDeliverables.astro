---
import type { CaseStudyDeliverable } from '@/types/content';
const { items = [] } = Astro.props as { items?: CaseStudyDeliverable[] };
---
{items.length > 0 && (
  <section class="case-deliverables" aria-labelledby="case-deliverables-title">
    <div class="container">
      <div class="case-section-heading">
        <h2 id="case-deliverables-title">Project Deliverables</h2>
        <p>Structured deliverable content adapts to the verified data available for each project.</p>
      </div>
      <div class="case-deliverables__grid">
        {items.map((item) => (
          <article class="case-deliverable surface">
            {item.value && <strong>{item.value}</strong>}
            <h3>{item.label}</h3>
            {item.detail && <p>{item.detail}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
<style>
.case-deliverables{padding-block:1rem;border-top:1px solid var(--color-border)}
.case-section-heading{display:grid;gap:.15rem;margin-bottom:.55rem}.case-section-heading h2{font-size:var(--fs-h2)}.case-section-heading p{font-size:var(--fs-body-sm);color:var(--color-text-muted)}
.case-deliverables__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem}
.case-deliverable{display:grid;align-content:start;gap:.18rem;padding:.82rem .9rem;box-shadow:none;min-height:5.3rem}
.case-deliverable strong{color:var(--color-brand-strong);font-size:1.45rem;line-height:1;font-weight:800;letter-spacing:-.035em}
.case-deliverable h3{font-size:var(--fs-card-title);letter-spacing:-.02em}.case-deliverable p{font-size:var(--fs-meta);color:var(--color-text-muted);line-height:1.35}
@media(max-width:47.99rem){.case-deliverables{padding-block:.82rem}.case-section-heading h2{font-size:1.45rem}.case-section-heading p{font-size:var(--fs-body-sm)}.case-deliverables__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:.35rem}.case-deliverable{padding:.55rem .38rem;min-height:5.25rem;text-align:center}.case-deliverable strong{font-size:1.25rem}.case-deliverable h3{font-size:var(--fs-meta);line-height:1.15}.case-deliverable p{font-size:var(--fs-caption);line-height:1.22}}
@media(max-width:23rem){.case-deliverables__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
