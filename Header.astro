---
import Brand from './Brand.astro';
import Button from './Button.astro';
import { site } from '@/data/site';
const pathname = Astro.url.pathname;
const active = (href:string) => href === '/work/' ? pathname.startsWith('/work') : href === '/services/' ? pathname.startsWith('/services') : pathname.startsWith(href);
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Brand />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {site.nav.map(item => <a class:list={{active:active(item.href)}} href={item.href}>{item.label}</a>)}
    </nav>
    <div class="site-header__cta"><Button href="/contact/" size="sm">Start a Project</Button></div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="container" aria-label="Mobile navigation">
      {site.nav.map(item => <a class:list={{active:active(item.href)}} href={item.href}>{item.label}</a>)}
      <Button href="/contact/">Start a Project</Button>
    </nav>
  </div>
</header>
<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');
    if (!toggle || !menu) return;
    const close = () => { toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Open menu'); menu.hidden = true; document.documentElement.classList.remove('menu-open'); };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    });
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { close(); toggle.focus(); } });
  })();
</script>
<style>
.site-header{position:sticky;top:0;z-index:var(--z-header);background:rgba(255,255,255,.96);border-bottom:1px solid var(--color-border);backdrop-filter:saturate(180%) blur(10px)}.site-header__inner{height:var(--header-h);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.5rem}.desktop-nav{display:flex;align-items:center;gap:1.75rem}.desktop-nav a{position:relative;padding:.35rem 0;font-size:.82rem;font-weight:500;color:#27364e}.desktop-nav a::after{content:"";position:absolute;left:0;right:0;bottom:-.65rem;height:2px;background:var(--color-brand);transform:scaleX(0);transition:transform var(--transition)}.desktop-nav a.active::after,.desktop-nav a:hover::after{transform:scaleX(1)}.site-header__cta{justify-self:end}.menu-toggle{display:none;width:2.75rem;height:2.75rem;border:0;background:transparent;align-items:center;justify-content:center;flex-direction:column;gap:4px;cursor:pointer}.menu-toggle span{width:18px;height:2px;background:var(--color-text);border-radius:3px}.mobile-menu{border-top:1px solid var(--color-border);background:white}.mobile-menu nav{display:grid;padding-block:1rem 1.25rem;gap:.35rem}.mobile-menu nav>a:not(.button){padding:.8rem;border-radius:var(--radius-md);font-weight:600}.mobile-menu nav>a.active:not(.button){background:var(--color-bg-soft);color:var(--color-brand)}@media(max-width:47.99rem){.site-header__inner{grid-template-columns:1fr auto}.desktop-nav,.site-header__cta{display:none}.menu-toggle{display:flex;justify-self:end}}
</style>
