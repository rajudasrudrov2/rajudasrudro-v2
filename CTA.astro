---
import Button from './Button.astro';
const { title = 'Have a project in mind?', description = 'Let’s turn your idea into high-converting content and modern web experiences.', primaryHref = '/contact/', primaryLabel = 'Start a Project', secondaryHref = '/work/', secondaryLabel = 'View My Work' } = Astro.props;
---
<section class="cta"><div><p class="eyebrow">Ready to create something amazing?</p><h2>{title}</h2><p>{description}</p></div><div class="cluster"><Button href={primaryHref}>{primaryLabel} <span aria-hidden="true">→</span></Button><Button href={secondaryHref} variant="dark">{secondaryLabel}</Button></div></section>
<style>.cta{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;background:linear-gradient(115deg,#0b1f2a,#102a37);color:white;padding:1.25rem 1.5rem;border-radius:var(--radius-md)}.cta h2{font-size:1.45rem}.cta p:not(.eyebrow){margin-top:.25rem;color:#cbd5e1;font-size:.78rem}.cta .eyebrow{color:#cbd5e1;font-size:.62rem}@media(max-width:47.99rem){.cta{align-items:flex-start;flex-direction:column}.cta .cluster{width:100%;display:grid;grid-template-columns:1fr 1fr}.cta .button{width:100%}}</style>
