---
import { site } from '@/data/site';
const { compact = false } = Astro.props;
---
<a class:list={["brand", { "brand--compact": compact }]} href="/" aria-label={`${site.name} — Home`}>
  <img src="/images/raju-das-rudro.webp" width="40" height="40" alt="" loading="eager" decoding="async" />
  <span class="brand__copy">
    <strong>{site.name}</strong>
    {!compact && <small>{site.shortRole}</small>}
  </span>
</a>
<style>
.brand{display:inline-flex;align-items:center;gap:.65rem;min-width:0}.brand img{width:2.5rem;height:2.5rem;border-radius:50%;object-fit:cover;border:1px solid var(--color-border)}.brand__copy{display:grid;line-height:1.1;min-width:0}.brand strong{font-family:var(--font-display);font-size:1.05rem;white-space:nowrap}.brand small{font-size:.66rem;color:var(--color-text-muted);white-space:nowrap;margin-top:.18rem}.brand--compact .brand__copy{display:none}@media(max-width:25rem){.brand small{display:none}}
</style>
