---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TrustMetric from '@/components/TrustMetric.astro';
import CTA from '@/components/CTA.astro';
import EmptyState from '@/components/EmptyState.astro';
import { services } from '@/data/services';
import { verifiedTrust } from '@/data/site';
---
<BaseLayout meta={{ title: 'Raju Das Rudro — AI UGC, AI Video & Web', description: 'AI UGC, AI video production, AI spokesperson videos and web design for modern brands.', pathname: '/' }}>
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">AI creative for real business impact</p>
        <h1>AI Creative, UGC &amp; Web Experiences Built for Modern Brands.</h1>
        <p class="lede">I help global brands create high-converting AI UGC video, AI-powered creative content, and modern websites that look great and drive real results.</p>
        <div class="cluster"><Button href="/work/">View My Work</Button><Button href="/contact/" variant="secondary">Start a Project</Button></div>
      </div>
      <div class="hero__visual surface" aria-label="Portrait of Raju Das Rudro">
        <img src="/images/raju-das-rudro.webp" width="635" height="640" alt="Raju Das Rudro" fetchpriority="high" decoding="async" />
        <div class="hero__note">Real people.<br/>Real results.<br/>with AI.</div>
      </div>
    </div>
  </section>

  <section class="metrics"><div class="container metrics__grid">
    {verifiedTrust.map((m, i) => <TrustMetric value={m.value} label={m.label} icon={i === 0 ? '★' : '✦'} />)}
    <TrustMetric value="AI UGC" label="Flagship Service" icon="◉" />
    <TrustMetric value="Global" label="International Clients" icon="◎" />
  </div></section>

  <section class="section"><div class="container">
    <SectionHeader title="Selected Work" description="Real portfolio items will be pulled from the V2 CMS after migration and verification." linkHref="/work/" linkLabel="View All Work" />
    <EmptyState title="Portfolio migration pending" description="No demo projects are rendered as real work in the production data layer." />
  </div></section>

  <section class="section section--soft"><div class="container">
    <SectionHeader title="How I Can Help" description="Four focused service areas for creative, growth and web." />
    <div class="grid-4">{services.map(service => <ServiceCard service={service} />)}</div>
  </div></section>

  <section class="section"><div class="container process">
    <SectionHeader title="A Simple Production Process" description="From idea to ready-to-use assets in clear steps." />
    <div class="process__grid">
      <article class="surface"><strong>01</strong><h3>Brief</h3><p>Share your goals, audience and creative direction.</p></article>
      <article class="surface"><strong>02</strong><h3>Create</h3><p>Creative assets are produced and refined.</p></article>
      <article class="surface"><strong>03</strong><h3>Deliver &amp; Refine</h3><p>Receive the final assets with revisions handled clearly.</p></article>
    </div>
  </div></section>

  <section class="section section--soft"><div class="container about-strip">
    <img src="/images/raju-das-rudro.webp" width="635" height="640" alt="Raju Das Rudro" loading="lazy" />
    <div><h2>About Raju Das Rudro</h2><p class="muted">AI creative, UGC and web specialist working with international brands and teams.</p><a href="/about/">More About Me →</a></div>
  </div></section>

  <div class="container cta-wrap"><CTA /></div>
</BaseLayout>
<style>
.hero{padding-top:3rem}.hero__grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(24rem,.98fr);align-items:center;gap:3rem}.hero__copy{display:grid;gap:1rem}.hero__copy h1{font-size:var(--fs-hero);max-width:12ch}.hero__copy .lede{max-width:38rem}.hero__visual{position:relative;min-height:28rem;overflow:hidden;background:var(--color-bg-soft)}.hero__visual img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.hero__note{position:absolute;right:1rem;bottom:1rem;background:rgba(255,255,255,.94);padding:.8rem;border-radius:var(--radius-md);font-family:var(--font-display);font-size:1.1rem;line-height:1.1}.metrics{border-block:1px solid var(--color-border)}.metrics__grid{display:grid;grid-template-columns:repeat(4,1fr)}.metrics__grid>*+*{border-left:1px solid var(--color-border)}.process__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.process article{padding:1.2rem;display:grid;grid-template-columns:auto 1fr;column-gap:.8rem;row-gap:.2rem;align-items:center}.process article>strong{grid-row:1/3;color:var(--color-brand);font-family:var(--font-display);font-size:1.6rem}.process article p{grid-column:2;color:var(--color-text-muted);font-size:.76rem}.about-strip{display:grid;grid-template-columns:9rem 1fr;gap:1.5rem;align-items:center}.about-strip img{aspect-ratio:4/3;width:100%;height:100%;object-fit:cover;border-radius:var(--radius-lg)}.about-strip>div{display:grid;gap:.55rem}.about-strip a{color:var(--color-brand);font-size:.78rem;font-weight:600}.cta-wrap{padding-block:1rem 2rem}@media(max-width:47.99rem){.hero{padding-top:1.5rem}.hero__grid{grid-template-columns:1fr;gap:1.5rem}.hero__copy h1{font-size:2.2rem;max-width:none}.hero__copy .cluster{display:grid;grid-template-columns:1fr 1fr}.hero__visual{min-height:20rem}.metrics__grid{grid-template-columns:repeat(2,1fr)}.metrics__grid>*{border-bottom:1px solid var(--color-border)}.metrics__grid>*:nth-child(3){border-left:0}.process__grid{grid-template-columns:1fr}.about-strip{grid-template-columns:6rem 1fr}}
</style>
